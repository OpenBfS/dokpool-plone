<tal:header-info-dropdown tal:define="
                            icons python:context.restrictedTraverse('@@iconresolver');
                          ">

  <button class="btn btn-icon"
          aria-label="Info"
          type="button"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('info-circle-fill', tag_class='me-2')" />
  </button>
  <ul class="dropdown-menu dropdown-menu-end menu-info-dropdown">
    <!-- Header: Softwareversion -->
    <li class="px-3 py-3 bg-light">
      <small class="d-block text-graublau-dunkel2">Softwareversion</small>
      <div class="h5 fw-bold mb-0 text-graublau-dunkel2">${view/get_dokpool_version}</div>
      <tal:debug tal:condition="python: view.available()">
        <p class="debug-label small mb-0 mt-2"
           i18n:translate="debug_viewlet_git_commit"
        >
           Git Commit:
          <span class="debug-value small"><a class="git_rev"
               tal:content="python: view.get_git_rev()"
               tal:attributes="
                 href python: 'https://git.starzel.de/bfs/dokpool/commit/' + view.get_git_rev();
               "
               i18n:translate=""
            >Git Rev</a></span></p>

        <p class="debug-label small mb-0"
           i18n:translate="debug_viewlet_git_branch"
        >Git Branch:
          <span class="debug-value"><a class="git_branch"
               tal:content="python:view.get_git_branch()"
               tal:attributes="
                 href python: 'https://git.starzel.de/bfs/dokpool/tree/' + view.get_git_branch();
               "
               i18n:translate=""
            >Git Branch</a></span></p>
      </tal:debug>
    </li>

    <!-- Menu list -->
    <!-- Release Info -->
    <li class="dropdown-item d-flex align-items-center justify-content-between py-3 list-item-compact">
      <div class="d-flex align-items-center gap-3">
        <tal:icon tal:replace="structure python:icons.tag('info-circle', tag_class='me-2')" />
        <a class="text-graublau-dunkel1 small">Release Info</a>
      </div>
    </li>

    <!-- Accessibility -->
    <li class="dropdown-item d-flex align-items-center justify-content-between py-3 list-item-compact">
      <div class="d-flex align-items-center gap-3">
        <tal:icon tal:replace="structure python:icons.tag('universal-access', tag_class='me-2')" />
        <a class="text-graublau-dunkel1 small">Accessibility</a>
      </div>
    </li>

    <!-- Hilfe -->
    <li class="dropdown-item d-flex align-items-center justify-content-between py-3 list-item-compact">
      <div class="d-flex align-items-center gap-3">
        <tal:icon tal:replace="structure python:icons.tag('question-square', tag_class='me-2')" />
        <a class="text-graublau-dunkel1 small">Hilfe</a>
      </div>
    </li>

    <!-- Impressum -->
    <li class="dropdown-item d-flex align-items-center justify-content-between py-3 list-item-compact">
      <div class="d-flex align-items-center gap-3">
        <tal:icon tal:replace="structure python:icons.tag('info-circle', tag_class='me-2')" />
        <a class="text-graublau-dunkel1 small">Impressum</a>
      </div>
    </li>
  </ul>
</tal:header-info-dropdown>
