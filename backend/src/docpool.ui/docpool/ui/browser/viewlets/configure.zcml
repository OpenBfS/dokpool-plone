<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="plonetheme.tokyo"
    >

  <browser:viewlet
      name="docpool.header"
      manager="plone.app.layout.viewlets.interfaces.IPortalTop"
      class="docpool.ui.browser.viewlets.header.PortalHeader"
      template="header.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="header.macros"
      for="*"
      template="header-navigation-macros.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="event-switcher-dropdown"
      for="*"
      class=".header.EventSwitcherDropdown"
      template="header-event-switcher-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="info-dropdown"
      for="*"
      class=".header.InfoDropdown"
      template="header-info-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="system-messages-dropdown"
      for="*"
      class=".header.SystemMessagesDropdown"
      template="header-system-messages-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="accessibility-dropdown"
      for="*"
      class=".header.AccessibilityDropdown"
      template="header-accessibility-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="user-dropdown"
      for="*"
      class=".header.UserDropdown"
      template="header-user-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="config-dropdown"
      for="*"
      class=".header.ConfigDropdown"
      template="header-config-dropdown.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:viewletManager
      name="docpool.sidebar.manager"
      provides=".sidebar.ISidebarManager"
      class="plone.app.viewletmanager.manager.BaseOrderedViewletManager"
      permission="zope2.View"
      />

  <browser:viewlet
      name="docpool.sidebar.info"
      manager=".sidebar.ISidebarManager"
      class=".sidebar.SidebarViewlet"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:viewletManager
      name="docpool.sidebar.appspecific.manager"
      provides=".sidebar.ISidebarAppSpecificManager"
      class="plone.app.viewletmanager.manager.BaseOrderedViewletManager"
      permission="zope2.View"
      />

  <browser:viewlet
      name="docpool.sidebar.elan"
      manager=".sidebar.ISidebarAppSpecificManager"
      class="plone.app.layout.viewlets.common.ViewletBase"
      template="sidebar-elan.pt"
      permission="zope2.View"
      layer="docpool.elan.interfaces.IELANActive"
      />

  <browser:viewletManager
      name="docpool.headernav.manager"
      provides=".header.IHeaderNavManager"
      class="plone.app.viewletmanager.manager.BaseOrderedViewletManager"
      permission="zope2.View"
      />

  <browser:viewlet
      name="docpool.headernav.eventswitcher"
      manager=".header.IHeaderNavManager"
      class=".header.EventSwitcherViewlet"
      template="header-event-switcher.pt"
      permission="zope2.View"
      layer="docpool.elan.interfaces.IELANActive"
      />

  <browser:viewlet
      name="docpool.footer"
      manager="plone.app.layout.viewlets.interfaces.IPortalFooter"
      class="docpool.ui.browser.viewlets.footer.PortalFooter"
      template="footer.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />
</configure>
