
<ul class="dropdown-menu menu-config-dropdown event-dropdown-menu"
    id="event-dropdown-menu"
    tal:define="
      icons python:context.restrictedTraverse('@@iconresolver');
      auth_token context/@@authenticator/token;
      checkPermission nocall: context/portal_membership/checkPermission;
    "
    i18n:domain="docpool.ui"
>
  <li class="dropdown-item event-switcher-detail d-flex align-items-stretch gap-3 border-bottom ${python:'last-in-section' if item['last'] else ''}"
      tal:repeat="item python: view.scenarios"
  >
    <div class="d-flex align-items-stretch flex-grow-1 gap-3 border-end ${selected_class}"
         tal:define="
           scenario python: item['scenario'];
           selected python: item['selected'];
           selected_class python: 'selected' if selected else '';
         "
    >
      <div class="icon-column">
        <tal:icon condition="selected"
                  replace="structure python:icons.tag('check-lg', tag_class='')"
        />
      </div>
      <div class="badge bg-warning text-dark tag-badge small">${scenario/event_type_title}</div>
      <div class="text-primary flex-grow-1 border-end event-title-column">
        <a href="${python:
                       f'{context.absolute_url()}/@@select_scenario?scenario={scenario.UID()}&amp;_authenticator={auth_token}'}">
                ${scenario/Title}
        </a>
      </div>
      <div class="small text-primary">${scenario/status_title}</div>
      <div class="small text-primary">${scenario/operation_mode_title}</div>
    </div>
    <div class="d-flex align-items-stretch gap-3"
         tal:define="
           scenario_url python: item['scenario'].absolute_url();
           actions python: item['actions'];
         "
    >
      <div class="icon-column">
        <a href="${scenario_url}">
          <tal:icon replace="structure python:icons.tag('info-circle', tag_class='')" />
        </a>
      </div>
      <div class="dropdown context-menu icon-column">
        <a class="btn btn-secondary text-bg-secondary btn-sm px-1"
           aria-expanded="false"
           href="#"
           role="button"
           data-bs-toggle="dropdown"
           tal:condition="actions"
        >
          ${structure:python:icons.tag('three-dots-vertical', tag_class='')}
        </a>
        <ul class="dropdown-menu dropdown-menu-end pe-2 shadow">
          <li tal:repeat="action actions">
            <a class="dropdown-item d-flex gap-2 align-items-center"
               href="${action/url}"
            >
              ${structure:python:icons.tag(action['icon'], tag_class='')}
              <tal:translate i18n:domain="plone"
                             i18n:translate=""
              >${action/text}</tal:translate>
            </a>
          </li>
        </ul>
      </div>
    </div>
  </li>
  <li class="dropdown-item d-flex align-items-stretch gap-3 border-bottom last-in-section">
    <div class="d-flex align-items-stretch flex-grow-1 gap-3 border-end">
      <div class="icon-column"></div>
      <div class="text-primary flex-grow-1 event-title-column">
        <a href="${python: view.dp_url}/archive">
          <tal:icon tal:replace="structure python:icons.tag('archive', tag_class='')" />
          <span i18n:translate="">Archived events</span>
        </a>
      </div>
    </div>
    <div class="d-flex align-items-stretch gap-3">
      <div class="icon-column">
        <a href="${python: view.dp_url}/archive">
          <tal:icon replace="structure python:icons.tag('chevron-right', tag_class='')" />
        </a>
      </div>
      <div class="icon-column"></div>
    </div>
  </li>
  <li class="dropdown-item event-switcher-detail d-flex align-items-end justify-content-end gap-3"
      tal:condition="python: checkPermission('docpool.elan.AddDPEvent', context)"
  >
    <div>
      <a class="btn btn-secondary"
         href="${python: view.dp_url}/contentconfig/scen/@@manage-subscribed-events"
      >
        <tal:icon replace="structure python:icons.tag('plus-circle', tag_class='icon-with-text')" />
        <span class="small"
              i18n:translate=""
        >Add scenario</span>
      </a>
    </div>
  </li>
</ul>
