<div class="dropdown"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
     "
>

  <button class="btn btn-icon"
          aria-label="Accessibility"
          type="button"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('universal-access', tag_class='me-2')" />
  </button>
  <ul class="dropdown-menu dropdown-menu-end menu-accessibility-dropdown menu-utility-dropdown">
    <li class="dropdown-item user-menu-action-item">
      <tal:icon tal:replace="structure python:icons.tag('universal-access', tag_class='user-menu-row-icon')" />
      <span class="user-menu-link">Accessibility</span>
      <span class="ms-auto">
        <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
      </span>
    </li>
  </ul>
</div>
