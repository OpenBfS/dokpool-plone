<div class="dropdown"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
     "
>

  <button class="btn btn-icon"
          aria-label="Accessibility"
          type="button"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('universal-access')" />
  </button>
  <ul class="dropdown-menu dropdown-menu-end menu-accessibility-dropdown menu-utility-dropdown">
    <li class="user-menu-action-item">
      <a class="dropdown-item user-menu-link"
         href="https://www.bfs.de/DE/service/barrierefreiheit/barrierefreiheit_node.html"
      >
        <tal:icon tal:replace="structure python:icons.tag('universal-access', tag_class='user-menu-row-icon')" />
        <span i18n:domain="plone"
              i18n:translate=""
        >Accessibility</span>
        <span class="ms-auto">
          <tal:icon tal:replace="structure python:icons.tag('box-arrow-up-right')" />
        </span>
      </a>
    </li>
  </ul>
</div>
