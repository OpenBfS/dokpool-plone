<div class="dropdown"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
       dp_url context/@@dp_url;
       portal_url context/@@plone_portal_state/portal_url;
       user_name python:view.user_name();
       can_access_user_preferences python:view.can_access_user_preferences();
     "
>
  <button class="btn btn-icon"
          aria-label="Benutzer"
          type="button"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('person-fill')" />
  </button>

  <ul class="dropdown-menu dropdown-menu-end menu-user-dropdown menu-utility-dropdown">
    <li class="user-menu-header-item">
      <a class="user-menu-profile-link"
         href="${portal_url}/@@user-preferences"
         tal:condition="can_access_user_preferences"
      >
        <span class="user-menu-kicker">angemeldet als</span>
        <strong class="user-menu-name"
                title="${user_name}"
                tal:content="user_name"
        >Username</strong>
        <span class="user-menu-arrow">
          <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
        </span>
      </a>
      <div class="user-menu-profile-link user-menu-profile-static"
           tal:condition="not:can_access_user_preferences"
      >
        <span class="user-menu-kicker">angemeldet als</span>
        <strong class="user-menu-name"
                title="${user_name}"
                tal:content="user_name"
        >Username</strong>
      </div>
    </li>
    <li class="user-menu-action-item">
      <a class="dropdown-item user-menu-link"
         href="${dp_url}/@@change-password"
      >
        <tal:icon tal:replace="structure python:icons.tag('key', tag_class='user-menu-row-icon')" />
        <span i18n:domain="plone"
              i18n:translate=""
        >Change Password</span>
      </a>
    </li>
    <li class="user-menu-action-item"
        tal:condition="can_access_user_preferences"
    >
      <a class="dropdown-item user-menu-link"
         href="${portal_url}/@@user-preferences"
      >
        <tal:icon tal:replace="structure python:icons.tag('wrench', tag_class='user-menu-row-icon')" />
        <span>Spracheinstellungen</span>
      </a>
    </li>
    <li class="user-menu-action-item">
      <a class="dropdown-item user-menu-link"
         href="${dp_url}/@@impersonate"
      >
        <tal:icon tal:replace="structure python:icons.tag('person', tag_class='user-menu-row-icon')" />
        <span i18n:domain="plone"
              i18n:translate=""
        >Impersonate</span>
      </a>
    </li>
    <li class="user-menu-action-item">
      <a class="dropdown-item user-menu-link"
         href="${portal_url}/logout"
      >
        <tal:icon tal:replace="structure python:icons.tag('door-open', tag_class='user-menu-row-icon')" />
        <span i18n:domain="plone"
              i18n:translate=""
        >Logout</span>
      </a>
    </li>
  </ul>
</div>
