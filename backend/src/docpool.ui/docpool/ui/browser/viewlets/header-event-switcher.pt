<tal:vars define="
            icons python:context.restrictedTraverse('@@iconresolver');
          "
          condition="python: view.dp is not None"
>
  <!-- Event button -->
  <a class="nav-btn event-card event-switcher-detail d-flex align-items-center px-3 text-decoration-none ${python: view.active}"
     href="${python: view.dp_url}"
  >
    <div tal:define="
           scenario python: view.selected_scenario;
         "
         tal:condition="python: scenario is not None"
    >
      <div class="text-primary text-truncate">${scenario/Title}</div>
      <div class="d-flex align-items-center gap-3 mt-1">
        <span class="badge bg-warning text-dark tag-badge small">${scenario/event_type_title}</span>
        <span class="small text-primary">${scenario/operation_mode_title}</span>
      </div>
    </div>
    <div class="text-primary small"
         tal:condition="python: view.selected_scenario is None"
         i18n:translate=""
    >Select scenario</div>
  </a>
  <!-- Event switcher narrow block -->
  <div class="nav-button event-switcher d-flex align-items-center justify-content-center border-end ${python: view.active}"
       aria-label="Event switcher"
       onclick="$('a#event-dropdown-load').click()"
       data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('chevron-down', tag_class='')" />
  </div>
  <ul class="dropdown-menu menu-config-dropdown event-dropdown-menu"
      id="event-dropdown-menu"
  >
    <li><a class="pat-inject"
         id="event-dropdown-load"
         href="${python: context.absolute_url()}/@@event-switcher-dropdown"
         data-pat-inject="source: #event-dropdown-menu; target: #event-dropdown-menu"
      >Loading&hellip;</a></li>
  </ul>
</tal:vars>
