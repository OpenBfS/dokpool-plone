<div class="sidebar align-items-center"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
     "
     tal:condition="python:not context.restrictedTraverse('@@plone_portal_state').anonymous()"
     i18n:domain="docpool.ui"
>

  <nav class="w-100 my-3 align-items-center">
    <ul class="nav nav-pills d-flex flex-row flex-nowrap flex-xl-column align-items-center w-100">

      <tal:appspecific replace="structure provider:docpool.sidebar.appspecific.manager" />

      <li class="nav-item flex-fill"
          tal:define="
            active python:view.is_active('chronology');
          "
          tal:condition="python:view.show_default_entries()"
      >
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           tal:attributes="
             href string:${view/base_url}/@@listing;
             class python:'nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none' + (' active fw-bold' if active else '');
             aria-current python:'page' if active else None;
           "
        >

          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('clock-fill', tag_class='me-0')" />
          </span>
          <span class="label text-center"
                i18n:translate=""
          >Chronology</span>
        </a>
      </li>

      <li class="nav-item flex-fill"
          tal:define="
            active python:view.is_active('entrytypes');
          "
          tal:condition="python:view.show_default_entries()"
      >
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           href="#"
           tal:attributes="
             href string:${view/base_url}/@@entrytypes;
             class python:'nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none' + (' active fw-bold' if active else '');
             aria-current python:'page' if active else None;
           "
        >
          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('diagram-3-fill', tag_class='me-0')" />
          </span>
          <span class="label text-center"
                i18n:translate="Entrytypes"
          >Entrytypes</span>
        </a>
      </li>

      <li class="nav-item flex-fill"
          tal:define="
            active python:view.is_active('journals');
          "
      >
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           href="#"
           tal:condition="python: view.show_journals()"
           tal:attributes="
             href string:${view/base_url}/@@journals;
             class python:'nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none' + (' active fw-bold' if active else '');
             aria-current python:'page' if active else None;
           "
        >
          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('book-half', tag_class='me-0')" />
          </span>
          <span class="label text-center"
                i18n:translate=""
          >Journal</span>
        </a>
      </li>

      <tal:tasks tal:condition="python: view.show_tasks()">
        <li class="nav-item flex-fill"
            tal:define="
              active python:view.is_active('tasks');
              number python: view.number_of_tasks();
            "
            tal:condition="python: number"
        >
          <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
             href="#"
             tal:condition="python: view.show_tasks()"
             tal:attributes="
               href string:${view/base_url}/@@tasks;
               class python:'nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none' + (' active fw-bold' if active else '');
               aria-current python:'page' if active else None;
             "
          >
            <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
              <tal:icon tal:replace="structure python:icons.tag('calendar-check-fill', tag_class='me-0')" />
            </span>
            <span class="label text-center">
              <span i18n:translate="">Tasks</span>
              (<span tal:replace="python: number"></span>)
            </span>
          </a>
        </li>
      </tal:tasks>
    </ul>
  </nav>

</div>
