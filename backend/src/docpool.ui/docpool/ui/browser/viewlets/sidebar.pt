<div class="sidebar align-items-center"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
     "
     tal:condition="python:not context.restrictedTraverse('@@plone_portal_state').anonymous()"
>

  <nav class="w-100 align-items-center">
    <ul class="nav nav-pills d-flex flex-row flex-xl-column align-items-center w-100">

      <tal:appspecific replace="structure provider:docpool.sidebar.appspecific.manager" />

      <li class="nav-item">
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           tal:attributes="
             href string:${view/base_url}/@@listing;
           "
        >

          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('clock-fill', tag_class='me-0')" />
          </span>
          <span class="label text-center">Chronologie</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           href="#"
           tal:attributes="
             href string:${view/base_url}/@@entrytypes;
           "
        >
          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('diagram-3-fill', tag_class='me-0')" />
          </span>
          <span class="label text-center">Eintragsarten</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           href="#"
        >
          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('book-half', tag_class='me-0')" />
          </span>
          <span class="label text-center">Protokoll</span>
        </a>
      </li>

      <li class="nav-item">
        <a class="nav-link d-flex flex-column align-items-center justify-content-center text-decoration-none"
           href="#"
        >
          <span class="icon-24 d-flex align-items-center justify-content-center mb-2">
            <tal:icon tal:replace="structure python:icons.tag('calendar-check-fill', tag_class='me-0')" />
          </span>
          <span class="label text-center">Aufgaben (1)</span>
        </a>
      </li>
    </ul>
  </nav>


</div>
