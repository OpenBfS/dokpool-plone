<div class="dropdown"
     tal:define="
       icons python:context.restrictedTraverse('@@iconresolver');
     ">

  <button class="btn btn-icon"
          aria-label="System messages"
          type="button"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('exclamation-triangle-fill', tag_class='me-2')" />
  </button>
  <div class="dropdown-menu dropdown-menu-end menu-system-messages-dropdown">
    <!-- Header: System messages -->
    <div class="px-3 py-3 bg-light">
      <div class="h5 fw-bold mb-0 text-graublau-dunkel2">System messages</div>
    </div>

    <!-- Menu list -->
    <ul class="list-group list-group-flush">
      <!-- Placeholder content -->
      <li class="list-group-item d-flex align-items-center justify-content-between py-3 list-item-compact">
        <div class="d-flex align-items-center gap-3">
          <span class="text-graublau-dunkel1 small">No new messages</span>
        </div>
      </li>
    </ul>
  </div>
</div>
