<?python
from docpool.base.appregistry import appLogo as appLogo

if view.current_app:
    app_logo = appLogo(view.current_app)

groups_folder = None
emergency_info = None
try:
    dp = context.myDocumentPool()
except BaseException:
    dp = None
else:
    try:
        groups_folder = dp["content"]["Groups"]
    except BaseException:
        pass
    try:
        emergency_info = dp["hintergrundinfos-ns"]
    except BaseException:
        pass
?>
<header class="app-header border-bottom"
        id="portal-header"
        tal:define="
          icons python:context.restrictedTraverse('@@iconresolver');
          auth_token context/@@authenticator/token;
        "
>
  <div class="container-fluid px-0">
    <div class="d-flex align-items-stretch">
      <!-- Left: Logo + System switcher -->
      <div class="d-flex align-items-center justify-content-center flex-column px-3 logo-block border-end">
        <a class="text-decoration-none d-flex flex-column align-items-start justify-content-center"
           accesskey="1"
           tal:attributes="
             href string:${view/navigation_root_url};
             title string:DocPool;
           "
           i18n:attributes="title"
           i18n:domain="docpool.elan"
        >
          <img src="${python: f'{view.site_url}/{app_logo}'}"
               tal:condition="app_logo"
          />
        </a>
        <div class="d-flex align-items-center gap-1 small text-primary fw-light">

          <button class="btn btn-icon app-switcher"
                  aria-label="Config"
                  data-bs-toggle="dropdown"
          >
            <span>${view/dp_title}</span>
            <tal:icon replace="structure python:icons.tag('chevron-down', tag_class='ms-1')" />
          </button>

          <ul class="dropdown-menu menu-config-dropdown">
            <li class="dropdown-item"
                tal:repeat="item python: view.apps_menu()"
            >
              <a href="${item/url}">${item/title}</a>
            </li>
          </ul>

        </div>
      </div>

      <!-- Middle: Event pill/button area with switcher and main nav buttons -->
      <div class="d-flex"
           aria-label="Event switcher"
           data-bs-toggle="dropdown"
      >
        <!-- Event button -->
        <div class="event-card event-switcher-detail d-flex align-items-center px-3">
          <div tal:define="
                 scenario python: view.selected_scenario;
               "
               tal:condition="python: scenario is not None"
          >
            <div class="text-primary">${scenario/Title}</div>
            <div class="d-flex align-items-center gap-3 mt-1">
              <span class="badge bg-warning text-dark tag-badge small">${scenario/event_type_title}</span>
              <span class="small text-primary">${scenario/operation_mode_title}</span>
            </div>
          </div>
          <div tal:condition="python: view.selected_scenario is None">
            <div class="text-primary small">Select scenario</div>
          </div>
        </div>
        <!-- Event switcher narrow block -->
        <div class="event-card event-switcher d-flex align-items-center justify-content-center border-end">
          <tal:icon tal:replace="structure python:icons.tag('chevron-down', tag_class='')" />
        </div>
      </div>
      <ul class="dropdown-menu menu-config-dropdown">
        <li class="dropdown-item"
            tal:repeat="scenario python: view.scenarios"
        >
          <a href="${python: f'{context.absolute_url()}/@@select_scenario?scenario={scenario.UID()}&amp;_authenticator={auth_token}'}">${scenario/Title}</a>
        </li>
      </ul>

      <!-- Main navigation buttons -->
      <div class="d-flex align-items-stretch flex-grow-1">
        <nav class="d-flex align-items-stretch">
          <a class="nav-btn d-flex flex-column justify-content-center px-4 border-end text-decoration-none"
             href="${groups_folder/absolute_url}"
             tal:condition="python: groups_folder is not None"
          >
            <span class="small text-primary mb-n1">My group folders</span>
          </a>
          <a class="nav-btn d-flex flex-column justify-content-center px-4 border-end text-decoration-none"
             href="${emergency_info/absolute_url}"
             tal:condition="python: emergency_info is not None"
          >
            <span class="small text-primary mb-n1">Emergency documents</span>
          </a>
        </nav>
      </div>

      <!-- Right: Icons -->
      <div class="d-flex align-items-center ms-auto gap-2 px-3">
        <button class="btn btn-icon"
                aria-label="Suche"
        >
          <tal:icon tal:replace="structure python:icons.tag('search', tag_class='me-2')" />
        </button>
        <img class="divider-vertical"
             alt=""
             src="/assets/divider-42.png"
        />
        <button class="btn btn-icon"
                aria-label="Barrierefreiheit"
        >
          <tal:icon tal:replace="structure python:icons.tag('universal-access', tag_class='me-2')" />
        </button>
        <button class="btn btn-icon"
                aria-label="Systemmeldung"
        >
          <tal:icon tal:replace="structure python:icons.tag('exclamation-triangle-fill', tag_class='me-2')" />
        </button>

        <tal:info tal:replace="structure context/@@info-dropdown">
          Info dropdown
        </tal:info>

        <tal:info tal:replace="structure context/@@config-dropdown">
          Config dropdown
        </tal:info>

        <tal:info tal:replace="structure context/@@user-dropdown">
          User dropdown
        </tal:info>


      </div>
    </div>
  </div>
</header>
