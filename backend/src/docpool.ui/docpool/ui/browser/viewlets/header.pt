<header class="app-header border-bottom"
        id="portal-header"
        tal:define="
          icons python:context.restrictedTraverse('@@iconresolver');
          auth_token context/@@authenticator/token;
        "
        tal:condition="python:not context.restrictedTraverse('@@plone_portal_state').anonymous()"
        i18n:domain="docpool.ui"
>
  <div class="container-fluid px-0">
    <div class="d-flex align-items-stretch">
      <!-- Left: Logo + System switcher -->
      <div class="d-flex align-items-center justify-content-center flex-column px-3 logo-block border-end">
        <a class="text-decoration-none d-flex flex-column align-items-start justify-content-center"
           accesskey="1"
           tal:attributes="
             href string:${view/navigation_root_url};
             title string:DocPool;
           "
           i18n:attributes="title"
           i18n:domain="docpool.elan"
        >
          <img src="${python: view.site_url}/${python: view.app_logo}"
               tal:condition="python: view.app_logo"
          />
        </a>
        <div class="d-flex align-items-center gap-1 small text-primary fw-light">

          <button class="btn btn-icon app-switcher"
                  aria-label="Config"
                  data-bs-toggle="dropdown"
          >
            <span tal:condition="python: view.dp is not None">${python: view.dp.title}</span>
            <span tal:condition="python: view.dp is None"
                  i18n:translate=""
            >Docpools</span>
            <tal:icon replace="structure python:icons.tag('chevron-down', tag_class='ms-1')" />
          </button>

          <ul class="dropdown-menu menu-config-dropdown app-dropdown-menu">
            <li class="dropdown-item d-table-row ${python: 'selected' if item['selected'] else ''}"
                tal:repeat="item python: view.apps_menu()"
            >
              <div class="d-table-cell border-bottom small">${item/dptitle}</div>
              <div class="d-table-cell border-bottom"
                   tal:repeat="app python:item['apps']"
              >
                <a class="border-start small text-primary"
                   href="${app/url}"
                   tal:condition="python: app"
                >${app/title}</a>
              </div>
            </li>
          </ul>

        </div>
      </div>

      <!-- Middle: Event pill/button area with switcher and main nav buttons -->
      <div class="d-flex align-items-stretch flex-grow-1">
        <nav class="navbar navbar-expand-lg d-flex align-items-stretch flex-grow-1 fixed-top">
          <div class="container-fluid w-100">

            <button class="btn btn-icon d-lg-none ms-auto mobile-search-btn"
                    aria-controls="portal-searchbox"
                    aria-label="Suche"
                    type="button"
                    data-bs-target="#portal-searchbox"
                    data-bs-toggle="offcanvas"
            >
              <tal:icon tal:replace="structure python:icons.tag('search')" />
            </button>

            <button class="navbar-toggler ms-2"
                    aria-controls="offcanvasNavbar"
                    aria-label="Toggle navigation"
                    type="button"
                    data-bs-target="#offcanvasNavbar"
                    data-bs-toggle="offcanvas"
            >
              <span class="navbar-toggler-icon"></span>
            </button>

            <div class="offcanvas offcanvas-end"
                 id="offcanvasNavbar"
                 aria-labelledby="offcanvasNavbarLabel"
                 tabindex="-1"
            >
              <div class="offcanvas-header">
                <h5 class="offcanvas-title"
                    id="offcanvasNavbarLabel"
                >Offcanvas</h5>
                <button class="btn-close"
                        aria-label="Close"
                        type="button"
                        data-bs-dismiss="offcanvas"
                ></button>
              </div>
              <div class="offcanvas-body">
                <div class="navbar-nav w-100 d-flex">
                  <tal:headernav replace="structure provider:docpool.headernav.manager" />
                  <!-- Main navigation buttons -->
                  <a class="nav-link nav-btn d-flex flex-column justify-content-center px-4 border-end text-decoration-none ${python: view.active['groups']}"
                     href="${python: view.groups_folder_url}"
                     tal:condition="python: view.groups_folder_url"
                  >
                    <span class="small text-primary mb-n1"
                          i18n:translate=""
                    >My group folders</span>
                  </a>
                  <a class="nav-link nav-btn d-flex flex-column justify-content-center px-4 border-end text-decoration-none ${python: view.active['emergency']}"
                     href="${python: view.emergency_info_url}"
                     tal:condition="python: view.emergency_info_url"
                  >
                    <span class="small text-primary mb-n1"
                          i18n:translate=""
                    >Emergency documents</span>
                  </a>


                  <!-- Right: Icons -->
                  <div class="nav-link right-icons d-none d-lg-flex align-items-center ms-auto gap-2 px-3">
                    <button class="btn btn-icon me-3 search-btn"
                            aria-controls="portal-searchbox"
                            aria-label="Suche"
                            type="button"
                            data-bs-target="#portal-searchbox"
                            data-bs-toggle="offcanvas"
                    >
                      <tal:icon tal:replace="structure python:icons.tag('search', tag_class='me-2')" />
                    </button>
                    <tal:accessibility tal:replace="structure context/@@accessibility-dropdown">
                        Accessibility dropdown
                    </tal:accessibility>

                    <tal:systemmessages tal:replace="structure context/@@system-messages-dropdown">
                        System messages dropdown
                    </tal:systemmessages>

                    <tal:info tal:replace="structure context/@@info-dropdown">
                        Info dropdown
                    </tal:info>

                    <tal:info tal:replace="structure context/@@config-dropdown">
                        Config dropdown
                    </tal:info>

                    <tal:info tal:replace="structure context/@@user-dropdown">
                        User dropdown
                    </tal:info>

                  </div>

                  <div class="d-lg-none w-100 mobile-settings-infos">
                    <div class="tab-content mobile-settings-tab-content"
                         id="mobile-settings-tab-content"
                    >
                      <div class="tab-pane fade show active"
                           id="mobile-settings-pane-main"
                           aria-labelledby="mobile-settings-main-tab-trigger"
                           role="tabpanel"
                      >
                        <h6 class="mobile-settings-infos-title">Einstellungen &amp; Infos</h6>
                        <div class="nav flex-column nav-pills mobile-settings-nav"
                             id="mobile-settings-nav"
                             aria-orientation="vertical"
                             role="tablist"
                        >
                          <button class="mobile-settings-link nav-link d-none active"
                                  id="mobile-settings-main-tab-trigger"
                                  aria-controls="mobile-settings-pane-main"
                                  aria-selected="true"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-main"
                                  data-bs-toggle="pill"
                          ></button>
                          <button class="mobile-settings-link nav-link"
                                  id="mobile-settings-tab-accessibility"
                                  aria-controls="mobile-settings-pane-accessibility"
                                  aria-selected="false"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-accessibility"
                                  data-bs-toggle="pill"
                          >
                            <span class="mobile-settings-icon">
                              <tal:icon tal:replace="structure python:icons.tag('universal-access')" />
                            </span>
                            <span class="mobile-settings-label">Barrierefreiheit</span>
                            <span class="mobile-settings-chevron">
                              <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                            </span>
                          </button>
                          <button class="mobile-settings-link nav-link"
                                  id="mobile-settings-tab-info"
                                  aria-controls="mobile-settings-pane-info"
                                  aria-selected="false"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-info"
                                  data-bs-toggle="pill"
                          >
                            <span class="mobile-settings-icon">
                              <tal:icon tal:replace="structure python:icons.tag('info-circle-fill')" />
                            </span>
                            <span class="mobile-settings-label">Infos</span>
                            <span class="mobile-settings-chevron">
                              <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                            </span>
                          </button>
                          <button class="mobile-settings-link nav-link"
                                  id="mobile-settings-tab-system-messages"
                                  aria-controls="mobile-settings-pane-system-messages"
                                  aria-selected="false"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-system-messages"
                                  data-bs-toggle="pill"
                          >
                            <span class="mobile-settings-icon">
                              <tal:icon tal:replace="structure python:icons.tag('exclamation-triangle-fill')" />
                            </span>
                            <span class="mobile-settings-label">Systemmeldungen</span>
                            <span class="mobile-settings-chevron">
                              <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                            </span>
                          </button>
                          <button class="mobile-settings-link nav-link"
                                  id="mobile-settings-tab-config"
                                  aria-controls="mobile-settings-pane-config"
                                  aria-selected="false"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-config"
                                  data-bs-toggle="pill"
                          >
                            <span class="mobile-settings-icon">
                              <tal:icon tal:replace="structure python:icons.tag('wrench')" />
                            </span>
                            <span class="mobile-settings-label">Konfiguration</span>
                            <span class="mobile-settings-chevron">
                              <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                            </span>
                          </button>
                          <button class="mobile-settings-link nav-link"
                                  id="mobile-settings-tab-user"
                                  aria-controls="mobile-settings-pane-user"
                                  aria-selected="false"
                                  role="tab"
                                  type="button"
                                  data-bs-target="#mobile-settings-pane-user"
                                  data-bs-toggle="pill"
                          >
                            <span class="mobile-settings-icon">
                              <tal:icon tal:replace="structure python:icons.tag('person-fill')" />
                            </span>
                            <span class="mobile-settings-label">Benutzereinstellungen</span>
                            <span class="mobile-settings-chevron">
                              <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                            </span>
                          </button>
                        </div>
                      </div>

                      <div class="tab-pane fade mobile-settings-pane"
                           id="mobile-settings-pane-accessibility"
                           aria-labelledby="mobile-settings-tab-accessibility"
                           role="tabpanel"
                      >
                        <button class="mobile-settings-back-link"
                                type="button"
                                data-mobile-settings-back="true"
                        >
                          <span class="mobile-settings-back-icon">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-left')" />
                          </span>
                          <span class="mobile-settings-back-label">Hauptmen&uuml;</span>
                          <span class="mobile-settings-back-chevron">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                          </span>
                        </button>
                        <div class="mobile-settings-pane-content">
                          <tal:accessibility-mobile tal:replace="structure context/@@accessibility-dropdown">
                              Accessibility dropdown
                          </tal:accessibility-mobile>
                        </div>
                      </div>

                      <div class="tab-pane fade mobile-settings-pane"
                           id="mobile-settings-pane-info"
                           aria-labelledby="mobile-settings-tab-info"
                           role="tabpanel"
                      >
                        <button class="mobile-settings-back-link"
                                type="button"
                                data-mobile-settings-back="true"
                        >
                          <span class="mobile-settings-back-icon">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-left')" />
                          </span>
                          <span class="mobile-settings-back-label">Hauptmen&uuml;</span>
                          <span class="mobile-settings-back-chevron">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                          </span>
                        </button>
                        <div class="mobile-settings-pane-content">
                          <tal:info-mobile tal:replace="structure context/@@info-dropdown">
                              Info dropdown
                          </tal:info-mobile>
                        </div>
                      </div>

                      <div class="tab-pane fade mobile-settings-pane"
                           id="mobile-settings-pane-system-messages"
                           aria-labelledby="mobile-settings-tab-system-messages"
                           role="tabpanel"
                      >
                        <button class="mobile-settings-back-link"
                                type="button"
                                data-mobile-settings-back="true"
                        >
                          <span class="mobile-settings-back-icon">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-left')" />
                          </span>
                          <span class="mobile-settings-back-label">Hauptmen&uuml;</span>
                          <span class="mobile-settings-back-chevron">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                          </span>
                        </button>
                        <div class="mobile-settings-pane-content">
                          <tal:systemmessages-mobile tal:replace="structure context/@@system-messages-dropdown">
                              System messages dropdown
                          </tal:systemmessages-mobile>
                        </div>
                      </div>

                      <div class="tab-pane fade mobile-settings-pane"
                           id="mobile-settings-pane-config"
                           aria-labelledby="mobile-settings-tab-config"
                           role="tabpanel"
                      >
                        <button class="mobile-settings-back-link"
                                type="button"
                                data-mobile-settings-back="true"
                        >
                          <span class="mobile-settings-back-icon">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-left')" />
                          </span>
                          <span class="mobile-settings-back-label">Hauptmen&uuml;</span>
                          <span class="mobile-settings-back-chevron">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                          </span>
                        </button>
                        <div class="mobile-settings-pane-content">
                          <tal:config-mobile tal:replace="structure context/@@config-dropdown">
                              Config dropdown
                          </tal:config-mobile>
                        </div>
                      </div>

                      <div class="tab-pane fade mobile-settings-pane"
                           id="mobile-settings-pane-user"
                           aria-labelledby="mobile-settings-tab-user"
                           role="tabpanel"
                      >
                        <button class="mobile-settings-back-link"
                                type="button"
                                data-mobile-settings-back="true"
                        >
                          <span class="mobile-settings-back-icon">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-left')" />
                          </span>
                          <span class="mobile-settings-back-label">Hauptmen&uuml;</span>
                          <span class="mobile-settings-back-chevron">
                            <tal:icon tal:replace="structure python:icons.tag('chevron-right')" />
                          </span>
                        </button>
                        <div class="mobile-settings-pane-content">
                          <tal:user-mobile tal:replace="structure context/@@user-dropdown">
                              User dropdown
                          </tal:user-mobile>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </nav>
      </div>


    </div>
  </div>
</header>
