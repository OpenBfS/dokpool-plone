<tal:header-user-dropdown tal:define="
                            icons python:context.restrictedTraverse('@@iconresolver');
                          ">
  <button class="btn btn-icon"
          aria-label="Benutzer"
          data-bs-toggle="dropdown"
  >
    <tal:icon tal:replace="structure python:icons.tag('person-fill', tag_class='me-2')" />
  </button>

  <ul class="dropdown-menu menu-user-dropdown">
    <li class="menu-item-version">
      User
    </li>
  </ul>
</tal:header-user-dropdown>
