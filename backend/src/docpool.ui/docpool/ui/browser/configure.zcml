<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    i18n_domain="docpool.theme"
    >

  <include
      package="z3c.jbot"
      file="meta.zcml"
      />
  <browser:jbot
      directory="template_overrides"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <include package=".viewlets" />

  <browser:page
      name="main_template"
      for="*"
      class=".main_template.MainTemplate"
      template="templates/main_template.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="listing"
      for="*"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.interfaces.IDocumentPool"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.interfaces.IFolderBase"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.content.groups.IGroups"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.content.users.IUsers"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.content.dptransfersarea.IDPTransfersArea"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.content.dptransferfolder.IDPTransferFolder"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.elan.content.elaninfos.IELANInfos"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.content.infofolder.IInfoFolder"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="plone.app.contenttypes.interfaces.IFolder"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.elan.content.elanarchive.IELANArchive"
      class=".listing.Listing"
      template="templates/listing.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="listing-item"
      for="*"
      class=".listing_item.Item"
      template="templates/listing-item.pt"
      permission="zope.Public"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="view"
      for="docpool.base.interfaces.IDPDocument"
      class=".dpdocument.DPDocumentView"
      template="templates/dpdocument.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="edit"
      for="docpool.base.interfaces.IDPDocument"
      class=".dpdocument.DPDocumentEditFormUI"
      template="templates/dpdocument-edit.pt"
      permission="cmf.ModifyPortalContent"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="delete_confirmation"
      for="docpool.base.interfaces.IDPDocument"
      class=".dpdocument.DPDocumentDeleteConfirmationFormUI"
      permission="zope2.DeleteObjects"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="attachments"
      for="docpool.base.interfaces.IDPDocument"
      class=".attachments.Attachments"
      template="templates/attachments.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="attachments_grid"
      for="docpool.base.interfaces.IDPDocument"
      class=".attachments.Attachments"
      template="templates/attachments_grid.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="attachments_list"
      for="docpool.base.interfaces.IDPDocument"
      class=".attachments.Attachments"
      template="templates/attachments_list.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <!-- The default view and edit views for debugging purposes -->
  <configure package="plone.app.dexterity.browser">
    <browser:page
        name="base_view"
        for="plone.dexterity.interfaces.IDexterityItem"
        class="plone.dexterity.browser.view.DefaultView"
        template="item.pt"
        permission="cmf.ManagePortal"
        />

    <browser:page
        name="base_view"
        for="plone.dexterity.interfaces.IDexterityContainer"
        class="plone.dexterity.browser.view.DefaultView"
        template="container.pt"
        permission="cmf.ManagePortal"
        />
  </configure>

  <browser:page
      name="dpdocument_wizard_1"
      for="*"
      class=".wizard.DPDocumentWizard"
      template="templates/wizard_1.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="dpdocument_wizard_2"
      for="*"
      class=".wizard.DPDocumentWizard"
      template="templates/wizard_2.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="dpdocument_wizard_3"
      for="*"
      class=".wizard.DPDocumentWizard"
      template="templates/wizard_3.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="entrytypes"
      for="*"
      class=".entrytypes.EntryTypes"
      template="templates/entrytypes.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

  <browser:page
      name="overview"
      for="*"
      class=".overview.Overview"
      template="templates/overview.pt"
      permission="zope2.View"
      layer="docpool.ui.interfaces.IUITheme"
      />

</configure>
