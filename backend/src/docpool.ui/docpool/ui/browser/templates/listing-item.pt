<div class="listing-item d-flex align-items-center border-top position-relative"
     tal:define="
       portal_state context/@@plone_portal_state;
       plone_view nocall:context/@@plone;
       toLocalizedTime nocall:plone_view/toLocalizedTime;
       portal_url portal_state/portal_url;
       data python: view.dpdocument;
       doctype python: data['doctype'];
       icons python:context.restrictedTraverse('@@iconresolver');
       token context/@@authenticator/token;
     "
     i18n:domain="docpool.base"
>

  <a class="pat-inject list-item-link stretched-link"
     href="#"
     data-pat-inject="trigger: default; source: #portal-column-content; target: #content-core; history: record"
     tal:attributes="
       href python: data['url'];
     "
  >
    <span class="visually-hidden">Stretched link to details view</span></a>
  <div class="text-center px-1 dateinfo flex-shrink-0">
    <div tal:content="python: toLocalizedTime(data['date'], time_only=1)">15:45</div>
    <div class="text-muted small"
         tal:content="python: toLocalizedTime(data['date'], long_format=0)"
    >16.12.2021</div>
  </div>

  <div class="me-3 doctype-box flex-shrink-0">
    <div class="h-100 doktype-icon-container px-3 pt-2 pb-1">
      <img class="doktype-icon p-1"
           alt="Type"
           src="doctype"
           tal:attributes="
             alt python: doctype;
             title python:data['doctype_title'];
             src python:data['doctype_icon_url'];
           "
      />
    </div>
    <div class="card-body review-state ${python:data['state_class']}">
      <p class="card-text text-center small"
         title="${python: data['state_title']}"
         tal:content="python: data['state_title']"
         i18n:attributes="title"
         i18n:translate=""
      >Review state</p>
    </div>
  </div>

  <div class="flex-fill text-box">

    <h3 class="mb-0"
       tal:content="python: data['title']"
    ></h3>
    <div class="description text-muted text-truncate"
         tal:content="python: data['description']"
    >
      Description
    </div>
  </div>

  <!-- Attachment Column -->
  <div class="py-2 px-3 position-relative z-2"
       tal:condition="python: data['attachments']"
  >
    <div class="d-flex gap-2">
      <!-- Preview Tiles -->
      <tal:items tal:repeat="item python: data['attachments'][:3]">
        <tal:item tal:define="
                    is_last repeat/item/end;
                    plus_number python: is_last and len(data['attachments']) > 3 and len(data['attachments']) - 3;
                  ">
          <div class="preview-tile position-relative bg-light rounded-1"
               tal:condition="python: item.portal_type == 'Image'"
          >
            <a class="pat-gallery"
               href=""
               tal:attributes="
                 href python: item.getURL() + '/@@images/image/large';
               "
            >
              <img class="w-100 h-100 object-fit-cover"
                   tal:attributes="
                     src python: item.getURL() + '/@@images/image/thumb';
                     alt python: item.title;
                     title python: item.title;
                   "
              />
            </a>
            <div class="position-absolute bottom-0 end-0 bg-light px-2 rounded-top-start rounded-bottom-end"
                 tal:condition="python: plus_number"
            >
              <span class="text-small text-gray-darker"
                    tal:content="python: '+' + str(plus_number)"
              >+3</span>
            </div>
          </div>
          <div class="preview-tile position-relative rounded-1"
               tal:condition="python: item.portal_type != 'Image'"
          >
            <div class="d-flex align-items-center justify-content-center h-100 bg-dark-subtle">
              <span class="text-gray-main bg-body-secondary p-1 rounded-1"
                    tal:content="python: item.content_type().split('/')[-1].upper()"
              >XLS</span>
              <div class="position-absolute bottom-0 end-0 bg-light px-2 rounded-top-start rounded-bottom-end"
                   tal:condition="python: plus_number"
              >
                <span class="text-small text-gray-darker"
                      tal:content="python: '+' + str(plus_number)"
                >+3</span>
              </div>
            </div>
          </div>
        </tal:item>
      </tal:items>
    </div>
  </div>

  <!-- Creator Column -->
  <div class="py-3 px-2"
       style="width: 158px;"
  >
    <div class="d-flex flex-column">
      <span class="text-small text-gray-darker text-truncate"
            tal:content="structure python: data['modified_by_user']"
      >Max Mustermann (Bund)</span>
      <span class="text-small text-gray-dark text-truncate"
            tal:content="structure python: data['modified_by_group']"
      >Messzentrale BfS (Bund)</span>
    </div>
  </div>

  <div class="ms-3 bg-light position-relative z-2">
    <div class="dropdown position-relative z-3">
      <a class="btn btn-secondary text-bg-secondary btn-sm"
         aria-expanded="false"
         href="#"
         role="button"
         data-bs-toggle="dropdown"
      >
        &#8942;
      </a>
      <ul class="dropdown-menu pe-2">
        <li>
          <a class="dropdown-item"
             href="#"
             tal:attributes="
               href python: f'{data['url']}/@@edit?_authenticator={token}';
             "
          >
            <img src="${python:icons.url('pencil')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Edit</span>
          </a>
        </li>
        <li>
          <a class="dropdown-item"
             href="#"
             tal:attributes="
               href python: f'{data['url']}/@@edit?_authenticator={token}';
             "
          >
            <img src="${python:icons.url('star')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Mark as Favorite</span>
             (TODO)
          </a>
        </li>
        <tal:transitions tal:repeat="transition python: data['available_transitions']">
          <li>
            <a class="dropdown-item transition pat-inject"
               href="#"
               data-pat-inject="source: #listing; target: #listing; trigger: default &amp;&amp; source: #global_statusmessage; target: #global_statusmessage; trigger: default "
               tal:define="
                 icon_name python: view.transition_icon(transition['id']);
               "
               tal:attributes="
                 href python:'%s/@@change_state?action=%s&amp;back_to_referer=1&amp;_authenticator=%s' % (data['url'], transition['id'], token);
                 id python: 'workflow-transition-' + transition['id'];
               "
            >
              <img src="${python:icons.url(icon_name)}" />
              <span tal:omit-tag=""
                    i18n:translate=""
              >
                ${python: transition['name']}</span></a>
          </li>
        </tal:transitions>
        <li>
          <a class="dropdown-item"
             href="#"
             tal:attributes="
               href python: f'{data['url']}?download_attachments=1';
             "
          >
            <img src="${python:icons.url('download')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Download all attachments</span>
          </a>
        </li>
        <li tal:condition="python: data['show_transfer_action']">
          <a class="dropdown-item pat-modal"
             href="#"
             data-pat-modal="class: large; source: #content"
             tal:attributes="
               href python:'%s/@@dpdocument_transfer_form?dpdocids:list=%s' % (context.absolute_url(), data['path']);
             "
          >
            <img src="${python:icons.url('box-arrow-up-right')}" />
            <span tal:omit-tag=""
                  i18n:translate=""
            >Transfer</span>

          </a></li>
        <li>
          <a class="dropdown-item pat-plone-modal"
             href="#"
             tal:attributes="
               href python: f'{data['url']}/@@delete_confirmation?_authenticator={token}';
             "
          >
            <img src="${python:icons.url('trash')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Delete</span>
          </a>
        </li>
        <li>
          <a class="dropdown-item"
             href="#"
             tal:attributes="
               href python: f'{data['url']}';
             "
          >
            <img src="${python:icons.url('scissors')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Cut</span>
             (TODO)
          </a>
        </li>
      </ul>
    </div>
  </div>

</div>
