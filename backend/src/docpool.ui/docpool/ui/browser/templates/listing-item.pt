<div class="d-flex align-items-center border-bottom py-2"
     tal:define="
       data view/dpdocument;
     "
>
  <div class="text-center me-3"
       style="width: 80px;"
  >
    <div class="fw-bold">15:45</div>
    <div class="text-muted small">16.12.2021</div>
  </div>
  <div class="me-3">
    <a class="btn btn-sm btn-outline-primary btn-favorite"
       href="#"
       tal:condition="python: data['wf_status'] != 'published'"
       tal:content="python: data['wf_status']"
       tal:attributes="
         data-item-url python: data['url'];
         data-item-id python: data['id'];
       "
    >WF Status</a>
  </div>
  <div class="flex-grow-1">
    <a href="#"
       tal:attributes="
         href python: data['url'];
       "
    >
      <h2 tal:content="python: data['title']"></h2>
    </a>
    <div class="fw-semibold"
         tal:content="python: data['docType']"
    >Messungen
    </div>
    <div class="text-muted text-truncate"
         style="max-width: 100%;"
    >
      dolor sit amet, consectetur adipiscing elit. Aenean commodo ligula eget...
    </div>
  </div>
  <div class="text-end ms-3"
       style="min-width: 150px;"
  >
    <div>Paul M&uuml;ller</div>
    <div class="text-muted small">Messzentrale BfS (Bund)</div>
  </div>
</div>
