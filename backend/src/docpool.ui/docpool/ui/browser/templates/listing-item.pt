<div class="listing-item d-flex align-items-center border-bottom position-relative doctype-${doctype}"
     tal:define="
       portal_state context/@@plone_portal_state;
       plone_view nocall:context/@@plone;
       toLocalizedTime nocall:plone_view/toLocalizedTime;
       portal_url portal_state/portal_url;
       data python: view.dpdocument;
       doctype python: data['doctype'];
       icons python:context.restrictedTraverse('@@iconresolver');
       token context/@@authenticator/token;
       came_from request/URL;
     "
     i18n:domain="docpool.ui"
>
  <a class="list-item-link stretched-link"
     href="#"
     tal:attributes="
       class python: view.pat_inject_class('list-item-link stretched-link');
       data-pat-inject python: view.pat_inject_config('content_and_sidebar' if view.folder_listing else 'content_only');
       href python: data['url'] + '?sidebar=' + view.sidebar if view.sidebar else data['url'];
       title python:data['doctype_title'];
     "
  >
    <span class="visually-hidden">Stretched link to details view</span>
  </a>

  <div class="listingitem-checkbox px-1"
       tal:condition="python: view.show_bulk_actions"
  >
    <input class="form-check-input"
           id="checkDefault"
           form="listing-primary-form"
           name="uuid:list"
           type="checkbox"
           tal:attributes="
             value python: data['uid'];
             id python: data['uid'];
           "
    />
  </div>

  <div class="listingitem-meta me-3 flex-shrink-0 d-flex flex-column align-items-center">
    <div class="doctype-box">
      <div class="h-100 text-center doctype-icon-container px-3 pt-2 pb-1">
        <tal:icon tal:replace="structure python:icons.tag(data['doctype_icon_name'], tag_class='entrytype ' + data['doctype_icon_name'], tag_alt=data['doctype_title'])" />
      </div>
      <div class="card-body review-state ${python:data['state_class']}">
        <p class="card-text text-center small"
           title="${python: data['state_title']}"
           tal:content="python: data['state_title']"
           i18n:attributes="title"
           i18n:domain="docpool.base"
           i18n:translate=""
        >Review state</p>
      </div>
    </div>

    <div class="text-center px-1 dateinfo">
      <div tal:content="python: toLocalizedTime(data['date'], time_only=1)">15:45</div>
      <div class="text-muted small"
           tal:content="python: toLocalizedTime(data['date'], long_format=0)"
      >16.12.2021
      </div>
    </div>
  </div>

  <div class="flex-fill text-box">

    <h3 class="mb-2"
        tal:content="python: data['title']"
    ></h3>
    <div class="description text-muted"
         tal:condition="python: data['text']"
         tal:content="python: data['text']"
    >
      Description
    </div>
  </div>

  <!-- Attachment Column -->
  <div class="listingitem-attachments py-2 px-3 position-relative z-2 d-none d-xl-block"
       tal:condition="python: data['attachments']"
  >
    <div class="d-flex gap-2">
      <!-- Preview Tiles -->
      <tal:items tal:repeat="item python: data['attachments'][:3]">
        <tal:item tal:define="
                    is_last repeat/item/end;
                    plus_number python: is_last and len(data['attachments']) > 3 and len(data['attachments']) - 3;
                  ">
          <div class="preview-tile position-relative bg-light rounded-1"
               tal:condition="python: item.portal_type == 'Image'"
          >
            <a class="pat-gallery"
               href=""
               tal:attributes="
                 href python: item.getURL() + '/@@images/image/large';
               "
            >
              <img class="w-100 h-100 object-fit-cover"
                   tal:attributes="
                     src python: item.getURL() + '/@@images/image/thumb';
                     alt python: item.title;
                     title python: item.title;
                   "
              />
            </a>
            <div class="position-absolute bottom-0 end-0 bg-light px-2 rounded-top-start rounded-bottom-end"
                 tal:condition="python: plus_number"
            >
              <span class="small text-gray-darker"
                    tal:content="python: '+' + str(plus_number)"
              >+3</span>
            </div>
          </div>
          <div class="preview-tile position-relative rounded-1"
               tal:define="
                 mimetype python: item.getObject().content_type().split('/')[-1];
                 is_pdf python: mimetype == 'pdf';
                 href python: item.getURL();
               "
               tal:condition="python: item.portal_type == 'File'"
          >
            <div class="d-flex align-items-center justify-content-center h-100 bg-dark-subtle"
                 tal:condition="python: not is_pdf"
            >
              <span class="text-gray-main bg-body-secondary p-1 rounded-1"
                    tal:content="python: item.getObject().content_type().split('/')[-1].upper()"
              >XLS</span>
              <div class="position-absolute bottom-0 end-0 bg-light px-2 rounded-top-start rounded-bottom-end"
                   tal:condition="python: plus_number"
              >
                <span class="-small text-gray-darker"
                      tal:content="python: '+' + str(plus_number)"
                >+3</span>
              </div>
            </div>
            <div class="d-flex align-items-center justify-content-center h-100 bg-dark-subtle"
                 tal:condition="python: is_pdf"
            >
              <a class="pat-plone-modal"
                 href=""
                 title="View"
                 data-pat-plone-modal='{"modalSizeClass": "modal-xl", "backdropOptions": {"opacity": 1}}'
                 tal:attributes="
                   href python: item.getURL() + '/@@pdfjs_file_view';
                 "
                 i18n:attributes="title"
                 i18n:domain="plone"
              >
                <img class="w-100 object-fit-contain border"
                     style="height: 64px"
                     tal:attributes="
                       src python: item.getURL() + '/@@preview?scale=mini';
                       alt python: item.getObject().content_type().split('/')[-1].upper();
                       title python: item.title;
                     "
                />
              </a>
              <div class="position-absolute bottom-0 end-0 bg-light px-2 rounded-top-start rounded-bottom-end"
                   tal:condition="python: plus_number"
              >
                <span class="small text-gray-darker"
                      tal:content="python: '+' + str(plus_number)"
                >+3</span>
              </div>

            </div>
          </div>
        </tal:item>
      </tal:items>
    </div>
  </div>

  <!-- Creator Column -->
  <div class="listingitem-creator py-3 px-2 d-none d-xl-block"
       style="width: 158px;"
  >
    <div class="d-flex flex-column">
      <span class="text-gray-darker text-truncate"
            tal:content="structure python: data['modified_by_user']"
      >Max Mustermann (Bund)</span>
      <span class="text-gray-dark text-truncate"
            tal:content="structure python: data['modified_by_group']"
      >Messzentrale BfS (Bund)</span>
    </div>
  </div>

  <div class="mx-3 listingitem-dropdown position-relative d-flex align-items-center justify-content-center">
    <div class="dropdown">
      <a class="btn btn-secondary text-bg-secondary btn-sm px-1"
         aria-expanded="false"
         href="#"
         role="button"
         data-bs-toggle="dropdown"
      >
        <img src="${python:icons.url('three-dots-vertical')}" />
      </a>
      <ul class="dropdown-menu pe-2 shadow">
        <li tal:condition="python: data['actions']['edit']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               class python: view.pat_inject_class('dropdown-item d-flex gap-2 align-items-center');
               data-pat-inject python: view.pat_inject_config();
               href python: f'{data['url']}/@@edit?_authenticator={token}&amp;came_from={came_from}';
             "
          >
            <img src="${python:icons.url('pencil')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Edit</span>
          </a>
        </li>
        <li tal:condition="python: data['actions']['transfer']">
          <a class="dropdown-item d-flex gap-2 align-items-center pat-modal"
             href="#"
             data-pat-modal="class: large; source: #content"
             tal:attributes="
               href python:'%s/@@dpdocument_transfer_form?uid:list=%s' % (context.absolute_url(), data['uid']);
             "
          >
            <img src="${python:icons.url('box-arrow-up-right')}" />
            <span tal:omit-tag=""
                  i18n:domain="docpool.base"
                  i18n:translate=""
            >Transfer</span>
          </a>
        </li>
        <li tal:condition="python: data['actions']['favorite']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               href python: f'{data['url']}/@@edit?_authenticator={token}';
             "
          >
            <img src="${python:icons.url('star')}" />
            <span tal:omit-tag=""
                  i18n:translate=""
            >Mark as Favorite</span>
          </a>
        </li>
        <tal:transitions tal:condition="python: data['actions']['transitions']"
                         tal:repeat="transition python: data['available_transitions']"
        >
          <li>
            <a class="dropdown-item d-flex gap-2 align-items-center transition"
               href="#"
               tal:define="
                 icon_name python: view.transition_icon(transition['id']);
               "
               tal:attributes="
                 class python: view.pat_inject_class('dropdown-item d-flex gap-2 align-items-center transition');
                 data-pat-inject python: view.pat_inject_config('listing_and_status');
                 href python:'%s/@@change_state?action=%s&amp;back_to_referer=1&amp;_authenticator=%s' % (data['url'], transition['id'], token);
                 id python: 'workflow-transition-' + transition['id'];
               "
            >
              <img src="${python:icons.url(icon_name)}" />
              <span tal:content="python: transition['name']"
                    tal:omit-tag=""
                    i18n:domain="docpool.base"
                    i18n:translate=""
              ></span>
            </a>
          </li>
        </tal:transitions>
        <li tal:condition="python: data['actions']['download_attachments']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               href python: f'{data['url']}?download_attachments=1';
             "
          >
            <img src="${python:icons.url('download')}" />
            <span tal:omit-tag=""
                  i18n:translate=""
            >Download all attachments</span>
          </a>
        </li>
        <li tal:condition="python: data['actions']['delete']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               class python: view.pat_inject_class('dropdown-item d-flex gap-2 align-items-center');
               data-pat-inject python: view.pat_inject_config();
               href python: f'{data['url']}/@@delete_confirmation?_authenticator={token}&came_from={came_from}';
             "
          >
            <img src="${python:icons.url('trash')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Delete</span>
          </a>
        </li>
        <li tal:condition="python: data['actions']['cut']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               href python: f'{data['url']}';
             "
          >
            <img src="${python:icons.url('scissors')}" />
            <span tal:omit-tag=""
                  i18n:domain="plone"
                  i18n:translate=""
            >Cut</span>
          </a>
        </li>
        <li tal:condition="python: data['actions']['print']">
          <a class="dropdown-item d-flex gap-2 align-items-center"
             href="#"
             tal:attributes="
               href python: f'{data['url']}/@@print';
             "
          >
            <img src="${python:icons.url('printer')}" />
            <span tal:omit-tag=""
                  i18n:domain="docpool.ui"
                  i18n:translate=""
            >Print</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

</div>
