<div id="edit-attachments"
     tal:define="
       items python: view.items();
       icons python:context.restrictedTraverse('@@iconresolver');
     "
     i18n:domain="docpool.ui"
>
  <tal:attachments condition="python: items">
    <div class="d-flex">
      <div class="p-2 flex-grow-1">
        <label><span i18n:translate="">Documents</span>
          (${python: len(items)})</label>
      </div>
      <div>
      </div>
    </div>

    <tal:list replace="structure python: context.restrictedTraverse('@@attachments_list')()" />
  </tal:attachments>
</div>
