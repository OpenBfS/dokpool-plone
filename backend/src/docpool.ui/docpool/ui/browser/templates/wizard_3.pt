<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.base"
>

  <body>

    <metal:content-core fill-slot="main">

      <form class="enableUnloadProtection"
            id="form"
            enctype="multipart/form-data"
            method="post"
            tal:define="
              errors view/errors;
              form python:view.form;
            "
            tal:attributes="
              action request/URL;
            "
      >

        <span tal:replace="structure context/@@authenticator/authenticator"></span>
        <input name="session_name"
               type="hidden"
               value=""
               tal:attributes="
                 value python:view.session_name;
               "
        />

        <h1 i18n:translate="">Create new entry</h1>

        <!-- SCENARIOS -->
        <div class="wizard-field"
             id="formfield-${widget_id}"
             tal:define="
               widget_name string:scenarios;
               widget_id python:widget_name.replace('.', '-');
               widget_value python:form.get(widget_name) or view.default_scenario();
               error python:errors.get(widget_name);
             "
             tal:attributes="
               class python:'wizard-field error' if error else 'wizard-field';
             "
        >
          <!-- Data -->
          <div class="wizard-field-data">
            <h2 class="wizard-field-label">
              <label for="${widget_name}">
                <span tal:attributes="
                        class python:view.is_required(widget_name);
                      "
                      i18n:translate=""
                >Event</span>
              </label>
            </h2>
            <div class="error-msg"
                 tal:condition="error"
            ><span tal:replace="error"></span></div>
            <div class="wizard-field field"
                 tal:define="
                   scenarios python: view.scenarios();
                 "
                 tal:attributes="
                   class python:error and 'wizard-field field error' or 'wizard-field field';
                 "
            >
              <select class="form-select select-widget choice-field"
                      id="${widget_id}"
                      name="${widget_name}"
                      size="1"
              >
                <option id="form-widgets-scenarios-novalue"
                        value=""
                        tal:condition="python:len(scenarios) > 1"
                        i18n:translate=""
                >Select a scenario</option>
                <option id="${item/value}"
                        value="${item/value}"
                        tal:repeat="item scenarios"
                        tal:content="item/title"
                        tal:attributes="
                          selected python:item.value == widget_value;
                        "
                >
                </option>
              </select>
            </div>
          </div>
        </div>

        <button class="btn btn-primary"
                name="form.buttons.continue"
                type="submit"
                i18n:translate=""
        >Continue</button>

      </form>

    </metal:content-core>

  </body>
</html>
