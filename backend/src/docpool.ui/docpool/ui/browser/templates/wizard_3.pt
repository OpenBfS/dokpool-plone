<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.base"
>

  <body>

    <metal:content-core fill-slot="main">

      <form class="enableUnloadProtection"
            id="form"
            enctype="multipart/form-data"
            method="post"
            tal:define="
              errors view/errors;
              form python:view.form;
            "
            tal:attributes="
              action request/URL;
            "
      >

        <span tal:replace="structure context/@@authenticator/authenticator"></span>
        <input name="session_name"
               type="hidden"
               value=""
               tal:attributes="
                 value python:view.session_name;
               "
        />

        <h1 i18n:translate="">Create new entry</h1>

        <!-- SCENARIOS -->
        <div class="mb-3"
             tal:condition="python: view.app == 'elan'"
        >
          <h2 class="wizard-field-label"
              tal:content="structure python: view.add_form.widgets['IELANDocument.scenarios'].label"
          ></h2>
          <div tal:replace="structure python: view.add_form.widgets['IELANDocument.scenarios'].render()"></div>
        </div>

        <!-- VISIBILITY -->
        <div class="wizard-field"
             id="formfield-${widget_id}"
             tal:define="
               widget_name string:visibility;
               widget_id python:widget_name.replace('.', '-');
               widget_value python:form.get(widget_name) or 'private';
               error python:errors.get(widget_name);
               visibility_options python: view.visibility_options();
             "
             tal:attributes="
               class python:'wizard-field mb-3 error' if error else 'wizard-field mb-3';
             "
             tal:condition="python: visibility_options"
        >
          <!-- Data -->
          <div class="wizard-field-data">
            <h2 class="wizard-field-label">
              <label for="${widget_name}">
                <span tal:attributes="
                        class python:view.is_required(widget_name);
                      "
                      i18n:translate=""
                >Visibility</span>
              </label>
            </h2>

            <div class="wizard-field"
                 tal:repeat="item python:visibility_options"
                 tal:attributes="
                   class python: error and 'wizard-field error' or 'wizard-field';
                 "
            >

              <div class="error-msg"
                   tal:condition="error"
              ><span tal:replace="error"></span></div>

              <label>
                <input name="${widget_name}"
                       type="radio"
                       value="${item/value}"
                       tal:define="
                         first_item repeat/item/start;
                         has_value python:True if widget_value else False;
                       "
                       tal:attributes="
                         checked python:item.value == widget_value if has_value else first_item;
                         title item;
                       "
                       i18n:attributes="title"
                />
                <span tal:replace="item/title"></span>
              </label>
            </div>

          </div>
        </div>

        <button class="btn btn-primary"
                name="form.buttons.continue"
                type="submit"
                i18n:translate=""
        >Continue</button>

      </form>

    </metal:content-core>

  </body>
</html>
