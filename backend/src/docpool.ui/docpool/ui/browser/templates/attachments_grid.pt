<tal:attachments define="
                   items python: view.items();
                   icons python:context.restrictedTraverse('@@iconresolver');
                 "
                 condition="python: items"
                 i18n:domain="docpool.ui"
>

  <div id="attachments">

    <div class="pat-gallery row row-cols-1 row-cols-md-3 g-4"
         data-pat-gallery="item-selector: a.gallery-item"
    >
      <div class="col"
           tal:repeat="item python: items"
      >
        <div class="h-100 text-bg-light"
             tal:define="
               is_image python: item.portal_type == 'Image';
               mime_type python: item.getObject().content_type();
               is_pdf python: not is_image and mime_type == 'application/pdf';
               pages python: view.pages(item.getObject()) if is_pdf else None;
             "
        >
          <tal:image condition="python: is_image">
            <a class="gallery-item"
               tal:attributes="
                 href python: item.getURL() + '/@@images/image/huge';
               "
            >
              <img class="rounded mx-auto d-block"
                   tal:attributes="
                     src python: item.getURL() + '/@@images/image/preview';
                   "
              />
            </a>
          </tal:image>
          <tal:pdf condition="python: is_pdf">
            <a class="pat-plone-modal"
               title="View"
               data-pat-plone-modal='{"modalSizeClass": "modal-xl", "backdropOptions": {"opacity": 1}}'
               tal:attributes="
                 href python: item.getURL() + '/@@pdfjs_file_view';
               "
               i18n:attributes="title"
               i18n:domain="plone"
            >
              <img class="rounded mx-auto d-block"
                   tal:attributes="
                     src python: item.getURL() + '/@@preview?scale=teaser';
                   "
              />
            </a>
          </tal:pdf>
          <tal:file condition="python: not is_pdf and not is_image">
            <a tal:attributes="
                 href python: item.getURL() + '/@@view';
               ">
              <p class="text-gray-main bg-body-secondary p-3 rounded-1"
                 tal:content="python: view.mimetype_name(mime_type)"
              >XLS</p>
            </a>
          </tal:file>
          <p>
            <span tal:content="python: item.title"></span>
            <tal:pages tal:condition="python: pages">
              (<span tal:content="python: pages"></span>
              <span i18n:translate="">Pages</span>)
            </tal:pages>
          </p>
          <p tal:content="python: item.description">Description.</p>
          <a class="pat-plone-modal"
             href=""
             title="View"
             data-pat-plone-modal='{"modalSizeClass": "modal-xl", "backdropOptions": {"opacity": 1}}'
             tal:condition="python: is_pdf"
             tal:attributes="
               href python: item.getURL() + '/@@pdfjs_file_view';
             "
             i18n:attributes="title"
             i18n:domain="plone"
          ><img src="${python:icons.url('eye')}" /></a>
          <a href=""
             title="Download"
             tal:attributes="
               href python: item.getURL();
             "
             i18n:attributes="title"
             i18n:domain="plone"
          ><img src="${python:icons.url('download')}" /></a>
        </div>
      </div>
    </div>

  </div>

</tal:attachments>
