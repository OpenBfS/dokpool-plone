<metal:page define-macro="master">
<tal:doctype tal:replace="structure string:&lt;!DOCTYPE html&gt;" />

<html
    tal:define="
        portal_state python:context.restrictedTraverse('@@plone_portal_state');
        portal_url python:portal_state.portal_url();
    ">
  <head>
    <link rel="stylesheet" type="text/css" href="${portal_url}/++plone++docpoolui/build/base.css" />
    <script src="${portal_url}/++plone++docpoolui/build/docpool.ui-remote.min.js"></script>
  </head>
  <body>

    <metal:content metal:define-macro="content">

      <metal:slot define-slot="body">

          <metal:bodytext define-slot="main">
              <metal:text define-slot="content-core" tal:content="nothing">
              </metal:text>
          </metal:bodytext>

      </metal:slot>

    </metal:content>

  </body>
</html>

</metal:page>
