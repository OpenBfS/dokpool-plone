<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.base"
>

  <body>

    <metal:content-core fill-slot="main">

      <form class="mx-3 my-3 rowlike pat-formunloadalert pat-formautofocus pat-validation enableFormTabbing"
            id="form"
            enctype="multipart/form-data"
            method="post"
            novalidate
            tal:define="
              errors view/errors;
              form python:view.form;
            "
            tal:attributes="
              action request/URL;
            "
      >

        <span tal:replace="structure context/@@authenticator/authenticator"></span>
        <input name="session_name"
               type="hidden"
               value=""
               tal:attributes="
                 value python:view.session_name;
               "
        />

        <h1 i18n:translate="">Create new entry</h1>

        <tal:block tal:define="
                     widget python:view.get_widget('IDublinCore.title');
                   ">
          <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
        </tal:block>

        <tal:block tal:define="
                     widget python:view.get_widget('text');
                   ">
          <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
        </tal:block>

        <!-- ATTACHMENTS -->
        <div class="wizard-field"
             id="formfield-${widget_id}"
             tal:define="
               widget_name string:attachments;
               widget_id python:widget_name.replace('.', '-');
               widget_value python:form.get(widget_name);
               error python:errors.get(widget_name);
             "
             tal:attributes="
               class python:'wizard-field mb-3 error' if error else 'wizard-field mb-3';
             "
        >
          <!-- Data -->
          <div class="wizard-field-data">
            <div class="wizard-field-label">
              <label for="${widget_name}">
                <span tal:attributes="
                        class python:view.is_required(widget_name);
                      "
                      i18n:translate="attachments"
                >Attachments</span>
              </label>
            </div>
            <div class="error-msg"
                 tal:condition="error"
            ><span tal:replace="error"></span></div>
            <div class="wizard-field field"
                 tal:attributes="
                   class python:error and 'wizard-field field error' or 'wizard-field field';
                 "
            >
              <input class="form-control"
                     id="attachments"
                     multiple
                     name="attachments"
                     type="file"
              />
            </div>
          </div>
        </div>

        <hr />

        <div class="accordion accordion-flush"
             id="advancedSettings"
        >
          <div class="accordion-item">
            <h2 class="accordion-header">
              <button class="accordion-button collapsed"
                      aria-controls="flush-collapseOne"
                      aria-expanded="false"
                      type="button"
                      data-bs-target="#flush-collapseOne"
                      data-bs-toggle="collapse"
              >
        Advanced Settings
              </button>
            </h2>
            <div class="accordion-collapse collapse"
                 id="flush-collapseOne"
                 data-bs-parent="#advancedSettings"
            >
              <div class="accordion-body">
                <tal:block tal:define="
                             widget python:view.get_widget('IExcludeFromNavigation.exclude_from_nav');
                           "
                           tal:condition="python: widget"
                >
                  <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
                </tal:block>

                <tal:block tal:define="
                             widget python:view.get_widget('IDublinCore.effective');
                           "
                           tal:condition="python: widget"
                >
                  <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
                </tal:block>
                <tal:block tal:define="
                             widget python:view.get_widget('IDublinCore.expires');
                           "
                           tal:condition="python: widget"
                >
                  <tal:widget tal:replace="structure widget/@@ploneform-render-widget" />
                </tal:block>

              </div>
            </div>
          </div>
        </div>

        <button class="btn btn-secondary me-3"
                formnovalidate="formnovalidate"
                name="form.buttons.cancel"
                type="submit"
                i18n:translate=""
        >Cancel</button>
        <button class="btn btn-outline-secondary ms-3"
                formnovalidate="formnovalidate"
                name="form.buttons.back"
                type="submit"
                i18n:translate=""
        >Back</button>
        <button class="btn btn-primary"
                name="form.buttons.continue"
                type="submit"
                i18n:translate=""
        >Next</button>

      </form>

    </metal:content-core>

  </body>
</html>
