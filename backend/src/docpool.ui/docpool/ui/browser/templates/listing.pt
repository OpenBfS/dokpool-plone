<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.base"
>
  <metal:content fill-slot="content-core"
                 tal:define="
                   items python: view.items;
                 "
  >
    <div class="m-2 container"
         id="listing-filters"
         tal:attributes="
           data-listing-modified python: view.modified;
         "
    >
      <form class="filter-form"
            method="GET"
      >
        <div class="d-flex flex-wrap justify-content-end">

          <div class="my-1 py-2 me-auto">
            <span tal:replace="python: len(items)"></span>
               Entries
          </div>

          <div class="m-1 dropdown">
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    i18n:translate=""
            >
            Time [ME(S)Z]
            </button>
            <div class="dropdown-menu p-2">
              <label class="form-label"
                     for="startdate"
                     i18n:translate=""
              >
                    Erstellt von
              </label>
              <div class="d-flex justify-content-between mb-3">
                <div>
                  <input class="form-control"
                         id="startdate"
                         name="startdate"
                         type="date"
                         value="${python: view.startdate}"
                  />
                </div>
                <div>
                  <input class="form-control"
                         id="starttime"
                         name="starttime"
                         type="time"
                         value="${python: view.starttime}"
                  />
                </div>
              </div>
              <label class="form-label"
                     for="enddate"
                     i18n:translate=""
              >
                    Erstellt bis
              </label>
              <div class="d-flex justify-content-between mb-3">
                <div>
                  <input class="form-control"
                         id="enddate"
                         name="enddate"
                         type="date"
                         value="${python: view.enddate}"
                  />
                </div>
                <div>
                  <input class="form-control"
                         id="endtime"
                         name="endtime"
                         type="time"
                         value="${python: view.endtime}"
                  />
                </div>
              </div>
              <button class="btn btn-outline-secondary mt-2"
                      formnovalidate="formnovalidate"
                      name="form.button.Reset"
                      type="submit"
                      value="Reset"
                      i18n:domain="zope"
                      i18n:translate="reset-button"
              >Reset</button>
              <button class="btn btn-primary mt-2"
                      formnovalidate="formnovalidate"
                      type="submit"
                      value="submit"
                      i18n:domain="plone"
                      i18n:translate=""
              >Filter</button>

            </div>
          </div>

          <div class="m-1 dropdown"
               tal:replace="nothing"
          >
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    i18n:translate=""
            >
          Anzahl der Eintr&auml;ge
            </button>
            <div class="dropdown-menu p-2">
              <tal:limit tal:repeat="limit_value python: [0, 5, 10]">
                <div class="form-check">
                  <input class="form-check-input"
                         id="${python: limit_value}"
                         name="limit"
                         onchange="this.form.submit()"
                         type="radio"
                         value="${python: limit_value}"
                         tal:attributes="
                           checked python: view.limit == limit_value;
                         "
                  />
                  <label class="form-check-label"
                         for="${python: limit_value}"
                  >
              ${python: limit_value or 'Alle'}
                  </label>
                </div>
              </tal:limit>
            </div>
          </div>

          <div class="m-1 dropdown"
               tal:define="
                 selected_doctypes python: view.selected_doctypes;
                 doctypes python: view.doctypes;
               "
          >
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
            >
          Eintragsart
            </button>
            <div class="dropdown-menu p-2 pat-checklist">
              <button class="btn btn-primary mt-2"
                      type="submit"
                      tal:condition="python: len(doctypes) > 5"
                      i18n:domain="plone"
                      i18n:translate=""
              >Filter</button>

              <div class="form-check"
                   tal:condition="python: len(doctypes) > 5"
              ><label><input class="form-check-input toggle-all"
                         type="checkbox"
                  /><span i18n:translate="label_toggle">Toggle all</span></label></div>
              <tal:doctypes tal:repeat="doctype python: doctypes">
                <div class="form-check">
                  <input class="form-check-input"
                         id="${python: 'selected_doctypes-' + doctype}"
                         name="selected_doctypes:list"
                         type="checkbox"
                         value="${python: doctype}"
                         tal:attributes="
                           checked python: doctype in selected_doctypes;
                           disabled python: not doctypes[doctype]['count'] and 'disabled';
                         "
                  />
                  <label class="form-check-label text-nowrap"
                         for="${python: 'selected_doctypes-' + doctype}"
                         i18n:translate=""
                  >
                    <span tal:replace="python: doctypes[doctype]['title']"
                          i18n:translate=""
                    ></span>
                    <span class="badge rounded-pill text-bg-secondary"
                          tal:content="python:doctypes[doctype]['count']"
                    ></span>
                  </label>
                </div>
              </tal:doctypes>
              <button class="btn btn-primary mt-2"
                      type="submit"
                      i18n:domain="plone"
                      i18n:translate=""
              >Filter</button>
            </div>
          </div>

          <div class="m-1 dropdown"
               tal:define="
                 selected_review_states python: view.selected_review_states;
               "
          >
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
            >
                Visibility
            </button>
            <div class="dropdown-menu p-2">
              <tal:doctypes tal:repeat="review_state python: view.review_states">
                <div class="form-check">
                  <input class="form-check-input"
                         id="${python: 'review_states-' + review_state}"
                         name="review_states:list"
                         type="checkbox"
                         value="${python: review_state}"
                         tal:attributes="
                           checked python: review_state in selected_review_states;
                           disabled python: not view.review_states[review_state]['count'] and 'disabled';
                         "
                  />
                  <label class="form-check-label text-nowrap"
                         for="${python: 'review_states-' + review_state}"
                  >
                    <span tal:replace="python: view.review_states[review_state]['title']"
                          i18n:translate=""
                    ></span>
                    <span class="badge rounded-pill text-bg-secondary"
                          tal:content="python:view.review_states[review_state]['count']"
                    ></span>
                  </label>
                </div>
              </tal:doctypes>
              <button class="btn btn-primary mt-2"
                      type="submit"
                      i18n:domain="plone"
                      i18n:translate=""
              >Filter</button>
            </div>
          </div>

          <div class="m-1">
            <div class="input-group">
              <input class="form-control"
                     aria-label="Search"
                     autocomplete="off"
                     name="searchable_text"
                     placeholder="Search on this page"
                     type="text"
                     tal:attributes="
                       value python: view.searchable_text or nothing;
                     "
              />
              <button class="btn border-light-subtle btn-light"
                      type="submit"
              >
                <tal:icon tal:replace="structure python:icons.tag('search', tag_alt='Search')" />
              </button>
            </div>
          </div>

          <div class="m-1 me-3 dropdown">
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    title="Sorting"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
            >
              <tal:icon tal:replace="structure python:icons.tag('sort-down')" />
            </button>
            <div class="dropdown-menu p-2">
              <div class="form-check"
                   tal:repeat="sort_on python: view.sort_on_options"
              >
                <input class="form-check-input"
                       id="${python: sort_on}"
                       name="sort_on"
                       onchange="this.form.submit()"
                       type="radio"
                       value="${python: sort_on}"
                       tal:attributes="
                         checked python: view.sort_on == sort_on;
                       "
                />
                <label class="form-check-label text-nowrap"
                       for="${python: sort_on}"
                       i18n:translate=""
                >
                  ${python: view.sort_on_options[sort_on][2]}
                </label>
              </div>
            </div>
          </div>

          <div class="m-1">
            <a class="btn btn-light"
               href="javascript:this.print();"
            >
              <tal:icon tal:replace="structure python:icons.tag('printer', tag_alt='Print')" />
            </a>
          </div>

          <div class="ms-1 my-1">
            <a class="btn btn-light"
               href="${python: context.absolute_url()}/@@dpdocument_wizard_1"
            >
              <tal:icon tal:replace="structure python:icons.tag('plus-circle', tag_alt='Add entry')" />
            </a>
          </div>
        </div>
      </form>
    </div>

    <div class="m-2 container border-bottom"
         id="listing"
    >
      <tal:block tal:repeat="item python: items">
        <a class="pat-inject"
           data-pat-inject="trigger: autoload-visible; delay: 50; target: self"
           tal:content="python: '@@listing-item?uid='+ item"
           tal:attributes="
             href python: '@@listing-item?uid='+ item;
           "
        >
        </a>
      </tal:block>
    </div>
  </metal:content>
</html>
