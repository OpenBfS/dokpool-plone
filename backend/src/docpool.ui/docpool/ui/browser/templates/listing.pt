<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.theme"
>
  <metal:content fill-slot="content-core">
    <div class="filter-form-container">
      <form class="filter-form"
            method="GET"
      >
        <label for="limit"
               i18n:translate=""
        >Limit results:</label>
        <select name="limit"
                onchange="this.form.submit()"
        >
          <option value="0"
                  tal:attributes="
                    selected python: view.limit == 0;
                  "
                  i18n:translate=""
          >Show all</option>
          <option value="5"
                  tal:attributes="
                    selected python: view.limit == 5;
                  "
          >5</option>
          <option value="10"
                  tal:attributes="
                    selected python: view.limit == 10;
                  "
          >10</option>
        </select>
        <label for="dokType"
               i18n:domain="docpool.base"
               i18n:translate=""
        >label_dpdocument_doctype</label>
        <select name="dokType"
                onchange="this.form.submit()"
        >
          <option value="">All</option>
          <tal:doktypes tal:repeat="dokType python: view.documenttypes_vocabulary">
            <option value="${python: dokType.token}"
                    tal:attributes="
                      selected python: view.dokType == dokType.token;
                    "
                    i18n:translate=""
            >${python: dokType.title}</option>
          </tal:doktypes>
        </select>
      </form>
    </div>
    <div id="docpool-listing"
         tal:attributes="
           data-listing-items python: view.items;
           data-listing-modified python: view.modified;
         "
    >JS/React does not work</div>
  </metal:content>
</html>
