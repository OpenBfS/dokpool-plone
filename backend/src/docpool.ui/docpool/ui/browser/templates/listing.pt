<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      metal:use-macro="context/@@main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.ui"
>
  <metal:content fill-slot="content-core"
                 tal:define="
                   items python: view.items;
                   folder_uids python: view.folder_uids;
                   other_uids python: view.other_uids;
                   icons python: context.restrictedTraverse('@@iconresolver');
                   show_scenario_filter_switch python: 'elan' in view.active_apps and view.folder_listing;
                 "
  >

    <metal:empty_title fill-slot="content-title" />
    <div class="mx-0 my-0 p-1 border-bottom"
         id="listing-filters"
         tal:attributes="
           data-listing-modified python: view.modified;
         "
    >
      <form class="filter-form"
            method="GET"
            tal:attributes="
              action request/ACTUAL_URL;
            "
      >
        <div class="d-flex flex-wrap justify-content-start justify-content-lg-end">

          <div class="mx-3 my-0 py-1 me-auto"
               tal:condition="python: 'journal_title' in view.filters"
          >
            <a class="btn btn-light btn-icon me-2"
               href="@@journals"
            >
              <img src="${python:icons.url('chevron-left')}" />
              <span class="small"
                    i18n:translate="back"
              >Zur&uuml;ck</span>
            </a>
            <strong tal:content="python: view.journal_title"></strong>
          </div>

          <div class="mx-3 my-0 py-2"
               tal:condition="python: 'entries' in view.filters"
               tal:attributes="
                 class python: 'mx-3 my-0 py-2 d-none d-lg-block' if show_scenario_filter_switch else 'mx-3 my-0 py-2 me-auto d-none d-lg-block';
               "
          >
            <span tal:replace="python: len(items)"></span>
            <span i18n:translate="">Entries</span>
          </div>

          <div class="mx-3 my-0 py-2 me-auto d-none d-lg-block"
               tal:condition="python: show_scenario_filter_switch"
          >
            <div class="form-check form-switch">
              <input class="form-check-input"
                     id="bypass_scenario_filter"
                     name="bypass_scenario_filter"
                     onchange="this.form.submit()"
                     role="switch"
                     type="checkbox"
                     tal:attributes="
                       checked python: view.bypass_scenario_filter;
                     "
              />
              <label class="form-check-label"
                     for="bypass_scenario_filter"
              >
                <tal:count condition="python: not view.bypass_scenario_filter">
                  <span tal:content="python: view.count_without_scenario_filter"></span>
                  <span i18n:translate="">more entries for other events</span>
                </tal:count>
                <tal:totalcount condition="python: view.bypass_scenario_filter">
                  <span i18n:translate="">for all events</span>
                </tal:totalcount>
              </label>
            </div>
          </div>

          <div class="mx-1 my-0 mt-1 dropdown d-none d-lg-block"
               tal:define="
                 is_selected python: view.startdate or view.starttime or view.enddate or view.endtime;
               "
               tal:condition="python: 'date' in view.filters"
          >
            <button class="btn btn-light dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    tal:attributes="
                      class python: 'btn dropdown-toggle ' + (is_selected and 'selected' or 'btn-light');
                    "
                    i18n:translate=""
            >
              <span class="dp-filter-reset-icon"
                    role="button"
                    tabindex="0"
                    title="Reset filter"
                 tal:condition="python: is_selected"
                 tal:attributes="
                data-filter-reset-url python: view.reset_url(['startdate', 'starttime', 'enddate', 'endtime']);
                "
                 i18n:attributes="title"
              >
                <tal:icon tal:replace="structure python:icons.tag('x-circle-fill')" />
              </span>
              <span>Time [ME(S)Z]</span>

            </button>
            <div class="dropdown-menu pt-2 pb-0 px-2">
              <label class="form-label"
                     for="startdate"
                     i18n:translate=""
              >
                    Created since
              </label>
              <div class="d-flex justify-content-between mb-2">
                <div>
                  <input class="form-control"
                         id="startdate"
                         name="startdate"
                         type="date"
                         value="${python: view.startdate}"
                  />
                </div>
                <div>
                  <input class="form-control"
                         id="starttime"
                         name="starttime"
                         type="time"
                         value="${python: view.starttime}"
                  />
                </div>
              </div>
              <label class="form-label"
                     for="enddate"
                     i18n:translate=""
              >
                    Created until
              </label>
              <div class="d-flex justify-content-between mb-1">
                <div>
                  <input class="form-control"
                         id="enddate"
                         name="enddate"
                         type="date"
                         value="${python: view.enddate}"
                  />
                </div>
                <div>
                  <input class="form-control"
                         id="endtime"
                         name="endtime"
                         type="time"
                         value="${python: view.endtime}"
                  />
                </div>
              </div>
              <div class="sticky-bottom bg-white py-2 d-flex justify-content-between gap-2">
                <a class="btn btn-secondary w-50"
                   href="${python: view.reset_url(['startdate', 'starttime', 'enddate', 'endtime'])}"
                   i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('x-lg')" />
                  </span>
                  Reset
                </a>
                <button class="btn btn-primary w-50"
                        formnovalidate="formnovalidate"
                        type="submit"
                        value="submit"
                        i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('check-lg')" />
                  </span>
                  Filter anwenden
                </button>
              </div>

            </div>
          </div>

          <div class="m-1 dropdowni d-none d-lg-block"
               tal:define="
                 selected_subcategories python: view.selected_subcategories;
                 categories python: view.doctype_categories;
                 is_selected python: selected_subcategories;
               "
               tal:condition="python: 'entrytype' in view.filters"
          >
            <button class="btn dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    tal:attributes="
                      class python: 'btn dropdown-toggle ' + (is_selected and 'selected' or 'btn-light');
                    "
                    i18n:translate=""
            >
              <span class="dp-filter-reset-icon"
                    role="button"
                    tabindex="0"
                    title="Reset filter"
                    tal:condition="python: is_selected"
                    tal:attributes="
                      data-filter-reset-url python: view.reset_url('selected_subcategories');
                    "
                    i18n:attributes="title"
              >
                <tal:icon tal:replace="structure python:icons.tag('x-circle-fill')" />
              </span>
              <span>Entrytype</span>
            </button>
            <div class="dropdown-menu pt-2 pb-0 px-2 pat-checklist">
              <div class="form-check"
                   tal:condition="python: len(categories) > 1"
              ><label><input class="form-check-input toggle-all"
                         type="checkbox"
                  /><span i18n:domain="docpool.base"
                        i18n:translate="label_toggle"
                  >Toggle all</span></label></div>
              <tal:category tal:repeat="category python: categories">
                <!-- HEADING -->
                <strong tal:content="python: category"></strong>

                <tal:subcategory tal:repeat="subcategory python: categories[category]">
                  <div class="form-check">
                    <input class="form-check-input"
                           id="${python: 'selected_subcategories-' + subcategory.replace(' ', '')}"
                           name="selected_subcategories:list"
                           type="checkbox"
                           value="${python: subcategory}"
                           tal:attributes="
                             checked python: subcategory in selected_subcategories;
                             disabled python: not categories[category][subcategory]['count'] and 'disabled';
                           "
                    />
                    <label class="form-check-label text-nowrap"
                           for="${python: 'selected_subcategories-' + subcategory.replace(' ', '')}"
                    >
                      <span tal:replace="python: subcategory"></span>
                      <span class="badge rounded-pill text-bg-secondary"
                            tal:condition="python:categories[category][subcategory]['count']"
                            tal:content="python:categories[category][subcategory]['count']"
                      ></span>
                    </label>
                  </div>
                </tal:subcategory>
              </tal:category>
              <div class="sticky-bottom bg-white py-2 d-flex justify-content-between gap-2">
                <a class="btn btn-secondary w-50"
                   href="${python: view.reset_url('selected_subcategories')}"
                   i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('x-lg')" />
                  </span>
                  Reset
                </a>
                <button class="btn btn-primary w-50"
                        type="submit"
                        i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('check-lg')" />
                  </span>
                  Filter anwenden
                </button>
              </div>
            </div>
          </div>

          <div class="m-1 dropdown d-none d-lg-block"
               tal:define="
                 selected_review_states python: view.selected_review_states;
                 is_selected python: selected_review_states;
               "
               tal:condition="python: 'visibility' in view.filters"
          >
            <button class="btn dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    tal:attributes="
                      class python: 'btn dropdown-toggle ' + (is_selected and 'selected' or 'btn-light');
                    "
                    i18n:translate=""
            >
              <span class="dp-filter-reset-icon"
                    role="button"
                    tabindex="0"
                    title="Reset filter"
                    tal:condition="python: is_selected"
                    tal:attributes="
                      data-filter-reset-url python: view.reset_url('review_states');
                    "
                    i18n:attributes="title"
              >
                <tal:icon tal:replace="structure python:icons.tag('x-circle-fill')" />
              </span>
              <span>Visibility</span>
            </button>
            <div class="dropdown-menu pt-2 pb-0 px-2">
              <tal:doctypes tal:repeat="review_state python: view.review_states">
                <div class="form-check">
                  <input class="form-check-input"
                         id="${python: 'review_states-' + review_state}"
                         name="review_states:list"
                         type="checkbox"
                         value="${python: review_state}"
                         tal:attributes="
                           checked python: review_state in selected_review_states;
                           disabled python: not view.review_states[review_state]['count'] and 'disabled';
                         "
                  />
                  <label class="form-check-label text-nowrap"
                         for="${python: 'review_states-' + review_state}"
                  >
                    <span tal:replace="python: view.review_states[review_state]['title']"
                          i18n:translate=""
                    ></span>
                    <span class="badge rounded-pill text-bg-secondary"
                          tal:content="python:view.review_states[review_state]['count']"
                    ></span>
                  </label>
                </div>
              </tal:doctypes>
              <div class="sticky-bottom bg-white py-2 d-flex justify-content-between gap-2">
                <a class="btn btn-secondary w-50"
                   href="${python: view.reset_url('review_states')}"
                   i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('x-lg')" />
                  </span>
                  Reset
                </a>
                <button class="btn btn-primary w-50"
                        type="submit"
                        i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('check-lg')" />
                  </span>
                  Filter anwenden
                </button>
              </div>
            </div>
          </div>

          <div class="m-1 dropdown d-none d-lg-block"
               tal:define="
                 selected_groups python: view.selected_groups;
                 groups python: view.groups;
                 is_selected python: selected_groups;
               "
               tal:condition="python: not view.folder_listing and 'group' in view.filters"
          >
            <button class="btn dropdown-toggle"
                    aria-expanded="false"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    tal:attributes="
                      class python: 'btn dropdown-toggle ' + (is_selected and 'selected' or 'btn-light');
                    "
                    i18n:translate=""
            >
              <span class="dp-filter-reset-icon"
                    role="button"
                    tabindex="0"
                    title="Reset filter"
                    tal:condition="python: is_selected"
                    tal:attributes="
                      data-filter-reset-url python: view.reset_url('selected_groups');
                    "
                    i18n:attributes="title"
              >
                <tal:icon tal:replace="structure python:icons.tag('x-circle-fill')" />
              </span>
              <span>Group</span>
            </button>
            <div class="dropdown-menu pt-2 pb-0 px-2 pat-checklist">
              <div class="form-check"
                   tal:condition="python: len(groups) > 5"
              ><label><input class="form-check-input toggle-all"
                         type="checkbox"
                  /><span i18n:domain="docpool.base"
                        i18n:translate="label_toggle"
                  >Toggle all</span></label></div>
              <tal:groups tal:repeat="group python: groups">
                <div class="form-check">
                  <input class="form-check-input"
                         id="${python: 'selected_groups-' + group}"
                         name="selected_groups:list"
                         type="checkbox"
                         value="${python: group}"
                         tal:attributes="
                           checked python: group in selected_groups;
                           disabled python: not groups[group]['count'] and 'disabled';
                         "
                  />
                  <label class="form-check-label text-nowrap"
                         for="${python: 'selected_groups-' + group}"
                  >
                    <span tal:replace="python: groups[group]['title']"></span>
                    <span class="badge rounded-pill text-bg-secondary"
                          tal:condition="python:groups[group]['count']"
                          tal:content="python:groups[group]['count']"
                    ></span>
                  </label>
                </div>
              </tal:groups>
              <div class="sticky-bottom bg-white py-2 d-flex justify-content-between gap-2">
                <a class="btn btn-secondary w-50"
                   href="${python: view.reset_url('selected_groups')}"
                   i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('x-lg')" />
                  </span>
                  Reset
                </a>
                <button class="btn btn-primary w-50"
                        type="submit"
                        i18n:translate=""
                >
                  <span class="me-1">
                    <tal:icon tal:replace="structure python:icons.tag('check-lg')" />
                  </span>
                  Filter anwenden
                </button>
              </div>
            </div>
          </div>
          <div class="m-1 dp-listing-search"
               tal:define="
                 is_selected python: view.searchable_text;
               "
               tal:condition="python: 'text' in view.filters"
          >
            <div class="input-group">
              <span class="input-group-text bg-body text-primary border-end-0"
                    aria-hidden="true"
              >
                <tal:icon tal:replace="structure python:icons.tag('search')" />
              </span>

              <input class="form-control border-start-0"
                     aria-label="Search"
                     autocomplete="off"
                     name="searchable_text"
                     placeholder="Search on this page…"
                     type="text"
                     tal:attributes="
                       value python: view.searchable_text or nothing;
                       class python: 'form-control border-start-0 ' + (is_selected and 'border-primary' or '');
                     "
                     i18n:attributes="placeholder"
                     i18n:translate=""
              />

              <a class="btn btn-light border border-start-0 dp-search-reset"
                 href="${python: view.reset_url('searchable_text')}"
                 title="Reset search"
                 i18n:attributes="title"
              >&times;</a>
            </div>
          </div>

          <div class="m-1 me-3 dropdown d-none d-lg-block"
               tal:define="
                 is_selected python: view.sort_on != list(view.sort_on_options.keys())[0];
               "
          >
            <button class="btn btn-icon dropdown-toggle"
                    aria-expanded="false"
                    title="Sorting"
                    type="button"
                    data-bs-auto-close="outside"
                    data-bs-toggle="dropdown"
                    tal:attributes="
                      class python: 'btn btn-icon dropdown-toggle btn-light ' + (is_selected and 'active' or '');
                    "
                    i18n:attributes="title"
            >
              <tal:icon tal:replace="structure python:icons.tag('sort-down')" />
            </button>
            <div class="dropdown-menu p-2">
              <div class="form-check"
                   tal:repeat="sort_on python: view.sort_on_options"
              >
                <input class="form-check-input"
                       id="${python: sort_on}"
                       name="sort_on"
                       onchange="this.form.submit()"
                       type="radio"
                       value="${python: sort_on}"
                       tal:attributes="
                         checked python: view.sort_on == sort_on;
                       "
                />
                <label class="form-check-label text-nowrap"
                       for="${python: sort_on}"
                >
                  ${python: view.sort_on_options[sort_on][2]}
                </label>
              </div>
            </div>
          </div>

          <div class="m-1">
            <a class="btn btn-light btn-icon d-none d-lg-block"
               href="javascript:this.print();"
               title="Print"
               i18n:attributes="title"
            >
              <tal:icon tal:replace="structure python:icons.tag('printer')" />
            </a>
          </div>

          <div class="ms-1 my-1 d-none d-lg-block"
               tal:condition="python: view.folder_listing and not view.is_archive"
          >
            <a class="btn btn-light btn-icon"
               href="${python: context.absolute_url()}/@@folder_wizard"
               title="Add folder"
               i18n:attributes="title"
            >
              <tal:icon tal:replace="structure python:icons.tag('folder-plus')" />
            </a>
          </div>

          <div class="ms-1 my-1"
               tal:condition="python: not view.is_archive"
          >
            <a class="btn btn-light btn-icon d-none d-lg-block"
               href="${python: context.absolute_url()}/@@dpdocument_wizard_1"
               title="Add entry"
               i18n:attributes="title"
            >
              <tal:icon tal:replace="structure python:icons.tag('plus-circle')" />
            </a>
          </div>
        </div>
      </form>

      <metal:mobile-listing-filter use-macro="context/@@listing.macros/macros/mobile_listing_filter" />

      <div class="mx-3 my-3"
           tal:condition="python: 'journal_title' in view.filters and view.show_add_form"
      >
        <form class="add-form"
              action=""
              method="GET"
        >
          <div class="d-flex flex-wrap">
            <div class="me-3 flex-fill">
              <textarea class="pat-tinymce form-control"
                        id="journalentry-text"
                        name="journalentry-text"
                        placeholder="New journal entry"
                        tal:attributes="
                          data-pat-tinymce python: view.tinymce_settings();
                        "
              ></textarea>
              <input name="journal_title"
                     type="hidden"
                     value="${python:request.get('journal_title')}"
              />
              <input name="journal_folder_uid"
                     type="hidden"
                     value="${python:request.get('journal_folder_uid')}"
              />
              <input name="selected_groups"
                     type="hidden"
                     value="${python:request.get('selected_groups')}"
              />
            </div>
            <div>
              <button class="btn btn-secondary me-1 mt-1"
                      style="font-size: 1.5rem"
                      title="Add journal entry"
                      type="submit"
                      i18n:attributes="placeholder"
              ><tal:icon tal:replace="structure python:icons.tag('send')" /></button>
            </div>
          </div>
        </form>
      </div>


      <div class="mx-3 my-3"
           id="listing"
           tal:attributes="
             data-items python: view.json_items;
           "
      >
        <tal:block tal:repeat="item python: folder_uids + other_uids + items">
          <a class="pat-inject list-item-inject-link"
             data-pat-inject="trigger: autoload-visible; delay: 50; target: self"
             tal:content="python: '@@listing-item?uid='+ item"
             tal:attributes="
               href python: '@@listing-item?uid='+ item;
             "
          >
          </a>
        </tal:block>
      </div>
    </div></metal:content>
</html>
