<tal:attachments define="
                   items python: view.items();
                   icons python:context.restrictedTraverse('@@iconresolver');
                   can_reorder python: view.can_reorder();
                   auth_token context/@@authenticator/token;
                 "
                 condition="python: items"
>

  <div id="attachments">
    <a class="pat-inject d-none"
       id="attachments-order-refresh"
       data-pat-inject="source: #attachments; target: #attachments; trigger: default"
       tal:attributes="
         href python: context.absolute_url() + '/@@attachments_list';
       "
    ></a>

    <table class="pat-gallery table table-striped"
           data-pat-gallery="item-selector: a.gallery-item"
    >
      <tbody>
        <tr tal:repeat="item python: items"
            tal:attributes="
              data-attachment-id python: item.id;
            "
        >
          <tal:item tal:define="
                      is_image python: item.portal_type == 'Image';
                      mime_type python: item.getObject().content_type();
                      is_pdf python: not is_image and mime_type == 'application/pdf';
                      is_last repeat/item/end;
                    ">
            <td>
              <a class="gallery-item"
                 target="_blank"
                 tal:content="python: item.title"
                 tal:attributes="
                   class python: 'gallery-item' if is_image else '';
                   href python: item.getURL() + '/@@images/image/huge' if is_image else item.getURL();
                 "
              >
              </a>
              <div class="float-end">
                <span class="badge text-bg-secondary"
                      tal:content="python: view.mimetype_name(mime_type)"
                ></span>
                <span tal:content="python: item.getSize()"></span>
              </div>
            </td>
            <td>
              <div class="float-end">
                <a class="pat-plone-modal"
                   href=""
                   title="View"
                   data-pat-plone-modal='{"modalSizeClass": "modal-xl", "backdropOptions": {"opacity": 1}}'
                   tal:condition="python: is_pdf"
                   tal:attributes="
                     href python: item.getURL() + '/@@pdfjs_file_view';
                   "
                   i18n:attributes="title"
                   i18n:domain="plone"
                ><img src="${python:icons.url('eye')}" /></a>
                <button class="btn btn-link p-0 attachment-move-down"
                        title="Move item down"
                        type="button"
                        tal:condition="python: can_reorder and not is_last"
                        tal:attributes="
                          data-attachment-id python: item.id;
                          data-move-url python: context.absolute_url() + '/fc-itemOrder';
                          data-authenticator auth_token;
                        "
                        i18n:attributes="title title_move_item_down"
                        i18n:domain="docpool.base"
                ><img alt=""
                       src="${python:icons.url('file-arrow-down')}"
                  /></button>
                <a href=""
                   title="Download"
                   tal:attributes="
                     href python: item.getURL() + '/@@download';
                   "
                   i18n:attributes="title"
                   i18n:domain="plone"
                ><img src="${python:icons.url('download')}" /></a>
                <a class="btn btn-link p-0 attachment-delete"
                   title="Delete"
                   tal:condition="python: view.can_delete(item)"
                   tal:attributes="
                     href python: view.delete_confirmation_url(item);
                   "
                   i18n:attributes="title"
                   i18n:domain="plone"
                ><img alt=""
                       src="${python:icons.url('x-circle-fill')}"
                  /></a>
              </div>
            </td>
          </tal:item>
        </tr>
      </tbody>
    </table>

  </div>

</tal:attachments>
