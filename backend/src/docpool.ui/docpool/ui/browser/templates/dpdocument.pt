<html xmlns="http://www.w3.org/1999/xhtml"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      tal:define="
        dummy python:request.set('ajax_load',1);
        can_edit python: context.canBeEdited();
        can_delete python: context.canBeDeleted();
        token context/@@authenticator/token;
        toLocalizedTime nocall: context/@@plone/toLocalizedTime;
        workflow_state python: view.workflow_state();
      "
      i18n:domain="docpool.ui"
>

  <body>
    <metal:body fill-slot="body">

      <div class="dp-document"
           id="content"
      >

        <div class="dp-document-header row mx-0 my-0 p-1 border-bottom align-items-center">
          <div class="col-sm-6">
            <h1 class="mb-0"
                tal:content="python: context.title"
            ></h1>
          </div>
          <div class="col-sm-6">

            <div class="actions">
              <ul class="list-group list-group-horizontal list-group-flush justify-content-end"
                  tal:attributes="
                    data-current-item python: context.UID();
                    data-sidebar python: request.get('sidebar');
                  "
              >

                <li class="list-group-item border-0 bg-transparent prev navigation-action">
                  <a class="pat-inject prev-item text-decoration-none"
                     data-pat-inject="trigger: default; source: #portal-column-content; target: #content; history: record &amp;&amp; source: #portal-column-one; target: #portal-column-one; trigger: default"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('chevron-left', tag_alt='Previous')" />
                    <span i18n:translate="previous_next_previous">Previous</span>
                  </a>
                </li>
                <li class="actions-divider actions-navigation-divider"
                    aria-hidden="true"
                ></li>
                <li class="list-group-item border-0 bg-transparent next navigation-action">
                  <a class="pat-inject next-item text-decoration-none"
                     data-pat-inject="trigger: default; source: #portal-column-content; target: #content; history: record &amp;&amp; source: #portal-column-one; target: #portal-column-one; trigger: default"
                  >
                    <span i18n:translate="previous_next_next">Next</span>
                    <tal:icon tal:replace="structure python:icons.tag('chevron-right', tag_alt='Next')" />
                  </a>
                </li>
                <li class="list-group-item border-0 bg-transparent icon-action">
                  <a href="javascript:this.print();"
                     title="Print this"
                     i18n:attributes="title"
                     i18n:domain="plone"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('printer')" />
                  </a>
                </li>

                <li class="list-group-item border-0 bg-transparent icon-action"
                    tal:condition="python: can_delete"
                >
                  <a class="pat-inject"
                     href="delete"
                     title="Delete"
                     data-pat-inject="source: #content; target: #content"
                     tal:attributes="
                       href python: f'{context.absolute_url()}/@@delete_confirmation?_authenticator={token}&amp;{view.came_from_query}';
                     "
                     i18n:attributes="title"
                     i18n:domain="plone"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('trash3')" />
                  </a>
                </li>
                <li class="list-group-item border-0 bg-transparent icon-action"
                    tal:condition="python: can_edit"
                >
                  <a href="edit"
                     title="Edit"
                     tal:attributes="
                       href python: f'{context.absolute_url()}/@@edit?_authenticator={token}&amp;{view.came_from_query}';
                     "
                     i18n:attributes="title"
                     i18n:domain="plone"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('pencil')" />
                  </a>
                </li>
                <li class="list-group-item border-0 bg-transparent icon-action dropdown"
                    tal:define="
                      available_transitions python: view.available_transitions();
                    "
                    tal:condition="python: available_transitions"
                >
                  <button class="btn btn-icon dropdown-toggle"
                          aria-expanded="false"
                          title="Change visibility"
                          type="button"
                          data-bs-auto-close="outside"
                          data-bs-toggle="dropdown"
                          tal:attributes="
                            class python: 'btn btn-icon dropdown-toggle btn-secondary';
                          "
                          i18n:attributes="title"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('arrow-left-right')" />
                  </button>
                  <ul class="dropdown-menu pe-2 shadow">
                    <li tal:repeat="transition python: available_transitions">
                      <a class="dropdown-item d-flex gap-2 transition"
                         href="#"
                         tal:define="
                           icon_name python: view.transition_icon(transition['id']);
                         "
                         tal:attributes="
                           href python:'%s/@@change_state?action=%s&amp;back_to_referer=1&amp;_authenticator=%s' % (context.absolute_url(), transition['id'], token);
                           id python: 'workflow-transition-' + transition['id'];
                         "
                      >
                        <img src="${python:icons.url(icon_name)}" />
                        <span tal:content="python: transition['name']"
                              tal:omit-tag=""
                              i18n:domain="docpool.base"
                              i18n:translate=""
                        ></span>
                      </a>
                    </li>
                  </ul>
                </li>
                <li class="list-group-item border-0 bg-transparent icon-action"
                    tal:condition="python: view.show_transfer_action"
                >
                  <a href="dpdocument_transfer_form"
                     title="Transfer"
                     tal:attributes="
                       href python:'%s/@@dpdocument_transfer_form?uid:list=%s' % (context.absolute_url(), context.UID());
                     "
                     i18n:attributes="title"
                     i18n:domain="docpool.base"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('arrow-up-right-square')" />
                  </a>
                </li>
                <li class="list-group-item border-0 bg-transparent back icon-action">
                  <a href="#"
                     title="Back"
                     tal:attributes="
                       href python: view.getDocpoolListingPath();
                       data-came_from python: view.getDocpoolListingPath() if request.get('came_from') else None;
                     "
                     i18n:attributes="title"
                  >
                    <tal:icon tal:replace="structure python:icons.tag('x-lg')" />
                  </a>
                </li>
              </ul>
            </div>

          </div>
        </div>

        <div class="row mx-3 my-3">
          <div class="col-sm-8">

            <div tal:condition="python: getattr(context.aq_base, 'text')">
              <label i18n:domain="plone"
                     i18n:translate=""
              >Text</label>
              <div tal:condition="python: context.aq_base.text"
                   tal:replace="structure python: context.text.output_relative_to(view.context)"
              ></div>
            </div>

            <tal:attachments replace="structure python: context.restrictedTraverse('@@attachments')()" />
          </div>

          <dl class="col-sm-4">

            <tal:elan condition="python: 'elan' in context.local_behaviors">

              <dt i18n:translate="">Document type and category</dt>
              <dd class="field mb-2"
                  tal:define="
                    doctype_data python: context.doctype_data();
                    doctype_title python: doctype_data.get('title') or context.dp_type();
                    subcategory python: context.subcategory();
                  "
              >
                <div>
                  ${structure:python:icons.tag(doctype_data.get('icon_name', 'question'))}
                  ${python: doctype_title}
                  <span tal:condition="subcategory">(${python: subcategory})</span>
                </div>
              </dd>

              <dt i18n:translate="">Visibility</dt>
              <dd class="field mb-2"
                  tal:define="
                    visibility python:view.visibility_options().get(workflow_state);
                  "
              >
                <div class="visibility-title state-${python: workflow_state}">${python: visibility['title']}</div>
                <div class="visibility-description">${python: visibility.get('description')}</div>
              </dd>

              <tal:published define="
                               pubinfo python: view.published_info();
                             "
                             condition="python: pubinfo"
              >
                <dt i18n:translate="">Last published</dt>
                <dd class="field mb-2">
                  <div>${structure:python:icons.tag('person')} ${python: pubinfo[1]}</div>
                  <div>${structure:python:icons.tag('clock')} ${python: view.timezone(pubinfo[0])} ${python: toLocalizedTime(pubinfo[0], long_format=True)}</div>
                </dd>
              </tal:published>

              <dt i18n:translate="">Last modified</dt>
              <dd class="field mb-2"
                  tal:define="
                    modinfo python:context.modInfo();
                  "
              >
                <div>${structure:python:icons.tag('person')} ${python: modinfo[1]}</div>
                <div>${structure:python:icons.tag('clock')} ${python: view.timezone(modinfo[0])} ${python: toLocalizedTime(modinfo[0], long_format=True)}</div>
              </dd>

              <dt i18n:translate="">Created</dt>
              <dd class="field mb-2"
                  tal:define="
                    modinfo python:context.modInfo(show_created=True);
                  "
              >
                <div>${structure:python:icons.tag('person')} ${python: modinfo[1]}</div>
                <div>${structure:python:icons.tag('clock')} ${python: view.timezone(modinfo[0])} ${python: toLocalizedTime(modinfo[0], long_format=True)}</div>
              </dd>

              <tal:location condition="python: view.group_folder">
                <dt i18n:translate="">Location</dt>
                <dd class="field mb-2">
                  <div>${structure:python:icons.tag('folder-fill')} ${python: view.group_folder.Title()}</div>
                </dd>
              </tal:location>

              <tal:event define="
                           widget python: view.widgets.get('IELANDocument.scenario');
                         "
                         condition="python: widget and view.event"
              >
                <dt>${python: widget.label}</dt>
                <dd class="field mb-2 event">${structure:python:view.event.Title()}</dd>
              </tal:event>

            </tal:elan>

          </dl>

        </div>

      </div>

    </metal:body>
  </body>
</html>
