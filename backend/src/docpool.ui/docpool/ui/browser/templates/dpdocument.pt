<html xmlns="http://www.w3.org/1999/xhtml"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      tal:define="
        dummy python:request.set('ajax_load',1);
        can_edit python: context.canBeEdited();
        can_delete python: context.canBeDeleted();
        token context/@@authenticator/token;
      "
      i18n:domain="docpool.ui"
>

  <body>
    <metal:body fill-slot="body">

      <div class="dp-document"
           id="content"
      >

        <div class="dp-document-header row mx-0 my-0 p-1 border-bottom">
          <div class="col-sm-6">
            <h1 tal:content="python: context.title"></h1>
          </div>
          <div class="col-sm-6">

            <div class="actions">
              <ul class="list-group list-group-horizontal list-group-flush justify-content-end"
                  tal:attributes="
                    data-current-item python: context.UID();
                  "
              >

                <li class="list-group-item border-0 bg-transparent prev">
                  <a class="pat-inject prev-item text-decoration-none"
                     data-pat-inject="trigger: default; source: #portal-column-content; target: #content; history: record"
                     i18n:translate="previous_next_previous"
                  >Previous</a>
                </li>
                <li class="list-group-item border-0 bg-transparent next">
                  <a class="pat-inject next-item text-decoration-none"
                     data-pat-inject="trigger: default; source: #portal-column-content; target: #content; history: record"
                     i18n:translate="previous_next_next"
                  >Next</a>
                </li>
                <li class="list-group-item border-0 bg-transparent">
                  <a class="pat-inject"
                     href="edit"
                     data-pat-inject="trigger: default; source: #content; target: #content; history: record"
                     tal:condition="python: can_edit"
                     tal:attributes="
                       href python: f'{context.absolute_url()}/@@edit?_authenticator={token}';
                     "
                  >
                    <tal:icon tal:replace="structure python:icons.tag('pencil', tag_alt='Edit')" />

                  </a>
                </li>
                <li class="list-group-item border-0 bg-transparent">
                  <a class="pat-inject"
                     href="delete"
                     data-pat-inject="source: #content; target: #content"
                     tal:condition="python: can_delete"
                     tal:attributes="
                       href python: f'{context.absolute_url()}/@@delete_confirmation?_authenticator={token}';
                     "
                  >

                    <tal:icon tal:replace="structure python:icons.tag('trash3', tag_alt='Delete')" />

                  </a>
                </li>

                <li class="list-group-item border-0 bg-transparent">
                  <a href="javascript:this.print();">
                    <tal:icon tal:replace="structure python:icons.tag('printer', tag_alt='Print')" />
                  </a>


                </li>
                <li class="list-group-item border-0 bg-transparent">

                  <a href="#">
                    <tal:icon tal:replace="structure python:icons.tag('star', tag_alt='Favorite')" />
                  </a></li>

                <li class="list-group-item border-0 bg-transparent back">
                  <a href="#"
                     tal:attributes="
                       href python: view.getDocpoolListingPath();
                     "
                  >
                    <tal:icon tal:replace="structure python:icons.tag('x-lg', tag_alt='Back')" />
                  </a>
                </li>
              </ul>
            </div>

          </div>
        </div>

        <div class="row mx-3 my-3">
          <div class="col-sm-8">

            <div tal:condition="python: getattr(context.aq_base, 'text')">
              <label i18n:domain="plone"
                     i18n:translate=""
              >Text</label>
              <div tal:condition="python: context.aq_base.text"
                   tal:replace="structure python: context.text.output_relative_to(view.context)"
              ></div>
            </div>

            <tal:attachments replace="structure python: context.restrictedTraverse('@@attachments')()" />
          </div>

          <dl class="col-sm-4">

            <tal:elan condition="python: 'elan' in context.local_behaviors">

              <dt i18n:translate="">Document type and category</dt>
              <dd class="field mb-2"
                  tal:define="
                    doctype python: context.docTypeObj();
                    doctype_title python: doctype.title if doctype else context.dp_type();
                    subcategory python: context.subcategory();
                  "
              >
                <div>
                  ${structure:python:icons.tag(getattr(doctype, 'icon_name', 'question'))}
                  ${python: doctype_title}
                  <span tal:condition="subcategory">(${python: subcategory})</span>
                </div>
              </dd>

              <dt i18n:translate="">Visibility</dt>
              <dd class="field mb-2"
                  tal:define="
                    visibility python:view.visibility_options()[view.workflow_state()];
                  "
              >
                <div class="visibility-title">${python: visibility['title']}</div>
                <div class="visibility-description">${python: visibility.get('description')}</div>
              </dd>

              <tal:published define="
                               pubinfo python: view.published_info();
                             "
                             condition="python: pubinfo"
              >
                <dt i18n:translate="">Last published</dt>
                <dd class="field mb-2">
                  <div>${structure:python:icons.tag('person')} ${python: pubinfo[1]}</div>
                  <div>${structure:python:icons.tag('clock')} ${python: pubinfo[0]}</div>
                </dd>
              </tal:published>

              <dt i18n:translate="">Last modified</dt>
              <dd class="field mb-2"
                  tal:define="
                    modinfo python:context.modInfo();
                  "
              >
                <div>${structure:python:icons.tag('person')} ${python: modinfo[1]}</div>
                <div>${structure:python:icons.tag('clock')} ${python: modinfo[0]}</div>
              </dd>

              <dt i18n:translate="">Created</dt>
              <dd class="field mb-2"
                  tal:define="
                    modinfo python:context.modInfo(show_created=True);
                  "
              >
                <div>${structure:python:icons.tag('person')} ${python: modinfo[1]}</div>
                <div>${structure:python:icons.tag('clock')} ${python: modinfo[0]}</div>
              </dd>

              <tal:location condition="python: view.group_folder">
                <dt i18n:translate="">Location</dt>
                <dd class="field mb-2">
                  <div>${structure:python:icons.tag('folder-fill')} ${python: view.group_folder.Title()}</div>
                </dd>
              </tal:location>

              <tal:event define="
                           widget python: view.widgets.get('IELANDocument.scenario');
                         "
                         condition="python: widget"
              >
                <dt>${python: widget.label}</dt>
                <dd class="field mb-2 event">${structure:python: widget.render()}</dd>
              </tal:event>

            </tal:elan>

          </dl>

        </div>

      </div>

    </metal:body>
  </body>
</html>
