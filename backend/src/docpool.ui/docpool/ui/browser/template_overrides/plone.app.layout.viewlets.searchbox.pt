<div class="offcanvas offcanvas-top overflow-y-auto"
     id="portal-searchbox"
     aria-labelledby="portal-searchbox-label"
     tabindex="-1"
     tal:define="
       navigation_root_url view/navigation_root_url;
       icons python:context.restrictedTraverse('@@iconresolver');
       requested_search_scope python:request.form.get('search_scope', 'current_event');
       selected_search_scope python:requested_search_scope if requested_search_scope in ('current_event', 'all_events', 'all_archives') else 'current_event';
     "
     tal:attributes="
       data-app-scope navigation_root_url;
     "
     i18n:domain="plone"
>
  <div class="offcanvas-body p-3">
    <h2 class="offcanvas-title visually-hidden"
        id="portal-searchbox-label"
        i18n:translate="label_search"
    >Search</h2>
    <form class="dp-search-form ${python: view.show_images and 'show_images'}"
          id="searchGadget_form"
          action="@@search"
          role="search"
          tal:attributes="
            action string:${navigation_root_url};
          "
    >

      <label class="hiddenStructure"
             for="searchGadget"
             i18n:translate="text_search"
      >Search Site</label>

      <div class="dp-search-row d-flex flex-column flex-md-row align-items-stretch w-100 bg-white rounded-1">
        <div class="dp-search-context-dropdown dropdown position-relative">
          <label class="visually-hidden"
                 for="search-context-dropdown-toggle"
          >Suchkontext</label>
          <button class="btn dp-search-context-btn event-switcher-detail d-inline-flex align-items-center justify-content-between justify-content-md-start text-nowrap text-white rounded-0"
                  id="search-context-dropdown-toggle"
                  aria-expanded="false"
                  type="button"
                  data-bs-toggle="dropdown"
          >
            <span class="dp-search-context-current-label"
                  tal:condition="python:selected_search_scope == 'all_events'"
                  i18n:translate=""
            >All events</span>
            <span class="dp-search-context-current-label"
                  tal:condition="python:selected_search_scope == 'all_archives'"
                  i18n:translate=""
            >All archives</span>
            <span class="dp-search-context-current-label"
                  tal:condition="python:selected_search_scope not in ('all_events', 'all_archives')"
                  i18n:translate=""
            >Current event</span>
            <tal:icon replace="structure python:icons.tag('chevron-down', tag_class='ms-2')" />
          </button>
          <input id="search-context-scope-input"
                 name="search_scope"
                 type="hidden"
                 value="current_event"
                 tal:attributes="
                   value selected_search_scope;
                 "
          />

          <ul class="dropdown-menu dp-search-context-menu w-100"
              id="search-context-dropdown-menu"
              aria-labelledby="search-context-dropdown-toggle"
          >
            <li class="dp-search-context-item">
              <button class="dp-search-context-link ${python:'selected' if selected_search_scope == 'current_event' else ''}"
                      type="button"
                      data-search-scope="current_event"
                      data-search-scope-label="Current event"
              >
                <span class="dp-search-context-link-title"
                      i18n:translate=""
                >Current event</span>
                <span class="dp-search-context-link-meta"
                      i18n:translate=""
                >Search only the selected event</span>
              </button>
            </li>
            <li class="dp-search-context-item">
              <button class="dp-search-context-link ${python:'selected' if selected_search_scope == 'all_events' else ''}"
                      type="button"
                      data-search-scope="all_events"
                      data-search-scope-label="All events"
              >
                <span class="dp-search-context-link-title"
                      i18n:translate=""
                >All events</span>
                <span class="dp-search-context-link-meta"
                      i18n:translate=""
                >Search all active events</span>
              </button>
            </li>
            <li class="dp-search-context-item">
              <button class="dp-search-context-link ${python:'selected' if selected_search_scope == 'all_archives' else ''}"
                      type="button"
                      data-search-scope="all_archives"
                      data-search-scope-label="All archives"
              >
                <span class="dp-search-context-link-title"
                      i18n:translate=""
                >All archives</span>
                <span class="dp-search-context-link-meta"
                      i18n:translate=""
                >Search archived events</span>
              </button>
            </li>
          </ul>
        </div>

        <div class="dp-search-input-wrap d-flex align-items-center flex-fill bg-white">
          <span class="dp-search-input-icon d-inline-flex align-items-center justify-content-center"
                aria-hidden="true"
          >
            <tal:icon replace="structure python:icons.tag('search')" />
          </span>

          <input class="searchField form-control dp-search-input border-0 shadow-none ps-0"
                 id="searchGadget"
                 name="searchable_text"
                 placeholder="ELAN durchsuchen"
                 size="18"
                 title="Search Site"
                 type="text"
                 value=""
                 tal:attributes="
                   value request/form/searchable_text|request/form/SearchableText|nothing;
                 "
                 i18n:attributes="title title_search_site"
          />
          <input name="from_global_search"
                 type="hidden"
                 value="1"
          />
          <button class="btn dp-search-dismiss h-100 rounded-0 bg-transparent lh-1"
                  aria-label="Suche schließen"
                  type="button"
                  data-bs-dismiss="offcanvas"
          >&times;</button>
        </div>
      </div>

      <button class="searchButton visually-hidden"
              type="submit"
              i18n:translate="label_search"
      >Search</button>

      <div class="hiddenStructure"
           id="portal-advanced-search"
      >
        <a href="#"
           tal:attributes="
             href string:${navigation_root_url}/@@search;
           "
           i18n:translate="label_advanced_search"
        >
            Advanced Search&hellip;
        </a>
      </div>

    </form>

    <div class="dp-search-suggestions row g-0 mt-4">
      <div class="col-12 col-md-3 dp-search-col-recent pe-md-4 mb-3 mb-md-0 pb-3 pb-md-0">
        <div class="d-flex align-items-center justify-content-between gap-2">
          <h3 class="dp-search-heading mb-0"
              i18n:translate=""
          >Letzte Suchen</h3>

        </div>
        <div class="d-flex flex-column gap-2"
             id="dp-recent-searches"
        >
        </div>
      </div>
    </div>
    <button class="btn btn-link p-0 text-decoration-none mt-4"
            id="dp-recent-searches-reset"
            type="button"
       i18n:translate=""
    >Reset
    </button>
  </div>

</div>
