<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="docpool.base"
    >

  <genericsetup:registerProfile
      name="to_1011"
      title="Upgrade profile for docpool.base"
      description=""
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1011"
      />

  <genericsetup:registerProfile
      name="to_1013"
      title="Upgrade profile for docpool.base"
      description=""
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1013"
      />

  <genericsetup:registerProfile
      name="to_3000"
      title="Upgrade profile for docpool.base"
      description=""
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_3000"
      />

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1009"
      destination="1010"
      >
    <genericsetup:upgradeStep
        title="Update REI Workflow to change BMUV to BMUKN"
        handler="docpool.base.upgrades.to_1010"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1010"
      destination="1011"
      >
    <genericsetup:upgradeStep
        title="Use full_full_review_history in history action"
        handler="docpool.base.upgrades.to_1011"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1011"
      destination="1012"
      >
    <genericsetup:upgradeStep
        title="Fix regex to find pdfs and images"
        handler="docpool.base.upgrades.to_1012"
        />
    <genericsetup:upgradeStep
        title="Reload dp_doc_workflow and remove Owner permissions in published state"
        handler="docpool.base.upgrades.to_1012_update_dp_doc_workflow"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1012"
      destination="1013"
      >
    <genericsetup:upgradeStep
        title="Add intids to all comments"
        handler="docpool.base.upgrades.to_1013_fix_comments"
        />
    <genericsetup:upgradeStep
        title="Reload dp_doc_workflow"
        handler="docpool.base.upgrades.to_1013_update_dp_doc_workflow"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1013"
      destination="1014"
      >
    <genericsetup:upgradeStep
        title="Update ELAN scenario index"
        handler="docpool.base.upgrades.to_1014_update_elan_scenario_index"
        />
    <genericsetup:upgradeStep
        title="Turn DPDocument's scenarios attribute into single-valued scenario attribute."
        handler="docpool.base.upgrades.to_1014_single_scenario_per_dpdocument"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="*"
      destination="3000"
      >
    <genericsetup:upgradeStep
        title="Upgrade existing database to use the new GUI"
        handler="docpool.base.upgrades.to_3000"
        />

    <genericsetup:upgradeStep
        title="Convert 'created_by', 'modified_by', 'transferred_by' fields to tupel"
        handler="docpool.base.upgrades.to_3000_convert_tupel"
        />

    <genericsetup:upgradeStep
        title="Generate previews for pdfs"
        handler="docpool.base.upgrades.to_3000_generate_previews"
        />

    <genericsetup:upgradeStep
        title="Migrate scenario journals"
        handler="docpool.base.upgrades.to_3000_refactor_journals"
        />

    <genericsetup:upgradeStep
        title="Remove 'scenarios' multiselection arteafacts"
        handler="docpool.base.upgrades.to_3000_remove_scenarios_multiselection"
        />

    <genericsetup:upgradeStep
        title="Upgrade to global event management"
        handler="docpool.base.upgrades.to_3000_global_events"
        />

    <genericsetup:upgradeStep
        title="Drop descriptions"
        handler="docpool.base.upgrades.to_3000_drop_description"
        />

    <genericsetup:upgradeStep
        title="Remove function users"
        handler="docpool.base.upgrades.to_3000_remove_function_users"
        />

  </genericsetup:upgradeSteps>

</configure>
