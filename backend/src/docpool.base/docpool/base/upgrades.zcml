<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:genericsetup="http://namespaces.zope.org/genericsetup"
    xmlns:i18n="http://namespaces.zope.org/i18n"
    i18n_domain="docpool.base"
    >

  <genericsetup:registerProfile
      name="to_1011"
      title="Upgrade profile for docpool.base"
      description=""
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1011"
      />

  <genericsetup:registerProfile
      name="to_1013"
      title="Upgrade profile for docpool.base"
      description=""
      provides="Products.GenericSetup.interfaces.EXTENSION"
      directory="profiles/to_1013"
      />

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1009"
      destination="1010"
      >
    <genericsetup:upgradeStep
        title="Update REI Workflow to change BMUV to BMUKN"
        handler="docpool.base.upgrades.to_1010"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1010"
      destination="1011"
      >
    <genericsetup:upgradeStep
        title="Use full_full_review_history in history action"
        handler="docpool.base.upgrades.to_1011"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1011"
      destination="1012"
      >
    <genericsetup:upgradeStep
        title="Fix regex to find pdfs and images"
        handler="docpool.base.upgrades.to_1012"
        />
    <genericsetup:upgradeStep
        title="Reload dp_doc_workflow and remove Owner permissions in published state"
        handler="docpool.base.upgrades.to_1012_update_dp_doc_workflow"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1012"
      destination="1013"
      >
    <genericsetup:upgradeStep
        title="Add intids to all comments"
        handler="docpool.base.upgrades.to_1013_fix_comments"
        />
    <genericsetup:upgradeStep
        title="Reload dp_doc_workflow"
        handler="docpool.base.upgrades.to_1013_update_dp_doc_workflow"
        />
  </genericsetup:upgradeSteps>

  <genericsetup:upgradeSteps
      profile="docpool.base:default"
      source="1013"
      destination="1014"
      >
    <genericsetup:upgradeStep
        title="Turn DPDocument's scenarios attribute into single-valued scenario attribute."
        handler="docpool.base.upgrades.to_1014_single_scenario_per_dpdocument"
        />
  </genericsetup:upgradeSteps>

</configure>
