<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.elan"
>
  <body>
    <metal:content-title fill-slot="content-title">
      <h1 i18n:translate="">Manage event subscriptions</h1>
    </metal:content-title>

    <metal:content-core fill-slot="content-core">
      <metal:content-core define-macro="content-core">
        <table class="table table-striped table-responsive table-bordered">
          <thead>
            <tr>
              <th i18n:translate="">Title/Description</th>
              <th i18n:translate="">Status</th>
              <th i18n:translate="">Action</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="item python:view.get_scenario_actions()">
              <tal:tr define="
                        scenario python:item[0];
                        action python:item[1];
                      ">
                <td tal:define="
                      event_type python:scenario.EventType or '';
                    ">
                  <a href=""
                     tal:attributes="
                       href python: scenario.absolute_url();
                     "
                  >
                    <tal:if condition="python: event_type == 'Exercise'">
                      <em i18n:translate="">++++ Exercise ++++</em>
                      <br />
                    </tal:if>
                    <tal:if condition="python: event_type == 'Test'">
                      <em i18n:translate="">++++ Test ++++</em>
                      <br />
                    </tal:if>

                    <b tal:content="python: scenario.title">
                                Title
                    </b>
                  </a>
                  <br />
                  <span tal:content="python:scenario.description"></span>
                </td>
                <td tal:content="scenario/Status"
                    i18n:translate=""
                ></td>
                <td>
                  <a href="${python:f'{view.document_pool.absolute_url()}/@@archiveAndClose?event={scenario.UID()}'}"
                     tal:condition="python:action == 'archive'"
                     i18n:translate=""
                  >
                    Archive and unsubscribe
                  </a>
                  <a href="${python:f'{request.getURL()}?scenario={scenario.UID()}&amp;action=unsubscribe'}"
                     tal:condition="python:action == 'unsubscribe'"
                     i18n:translate=""
                  >
                    Unsubscribe
                  </a>
                  <a href="${python:f'{request.getURL()}?scenario={scenario.UID()}&amp;action=subscribe'}"
                     tal:condition="python:action == 'subscribe'"
                     i18n:translate=""
                  >
                    Subscribe
                  </a>
                </td>
              </tal:tr>
            </tr>
          </tbody>
        </table>
        <p>
          <a href="${python:context.absolute_url()}"
             i18n:translate=""
          >Event overview</a>
        </p>
        <p tal:define="
             global_events_link python: view.global_events_link;
           "
           tal:condition="global_events_link"
        >
          <a href="${global_events_link}"
             i18n:translate=""
          >Edit global events</a>
        </p>
      </metal:content-core>
    </metal:content-core>
  </body>
</html>
