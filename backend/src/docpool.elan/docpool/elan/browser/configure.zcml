<configure
    xmlns="http://namespaces.zope.org/zope"
    xmlns:browser="http://namespaces.zope.org/browser"
    xmlns:plone="http://namespaces.plone.org/plone"
    i18n_domain="docpool.elan"
    >

  <include package="plone.app.contentmenu" />

  <plone:static
      directory="static"
      name="docpool.elan"
      type="plone"
      />

  <browser:page
      name="view"
      for="..interfaces.IDPEvents"
      class=".dpevents.DPEventsView"
      template="dpevents.pt"
      permission="zope2.View"
      />

  <browser:page
      name="manage-subscribed-events"
      for="..interfaces.IDPEvents"
      class=".dpevents.ManageSubscribedEvents"
      template="manage_subscribed_events.pt"
      permission="docpool.elan.AddDPEvent"
      />

  <browser:page
      name="view"
      for="..interfaces.IDPEvent"
      class=".dpevent.DPEventView"
      template="dpevent.pt"
      permission="zope2.View"
      />

  <browser:page
      name="archiveAndClose"
      for="docpool.base.content.documentpool.IDocumentPool"
      class=".archive_event_form.ArchiveAndClose"
      template="archive_event_form.pt"
      permission="cmf.ModifyPortalContent"
      />

  <browser:page
      name="snapshot"
      for="docpool.base.content.documentpool.IDocumentPool"
      class=".archive_event_form.Snapshot"
      template="archive_event_form.pt"
      permission="cmf.ModifyPortalContent"
      />

  <browser:page
      name="select_scenario"
      for="*"
      class=".dpevents.SelectScenario"
      permission="zope2.View"
      />

  <browser:page
      name="elan.macros"
      for="*"
      template="elan_macros.pt"
      permission="zope2.View"
      />

  <browser:page
      name="view"
      for="..content.elanarchive.IELANArchive"
      class=".elanarchive.ELANArchiveView"
      permission="zope2.View"
      />

  <browser:page
      name="view"
      for="..content.elanarchives.IELANArchives"
      class=".elanarchives.ELANArchivesView"
      permission="zope2.View"
      />

  <browser:page
      name="selectCategories"
      for="*"
      class=".popup.SelectCategories"
      permission="zope2.View"
      />

</configure>
