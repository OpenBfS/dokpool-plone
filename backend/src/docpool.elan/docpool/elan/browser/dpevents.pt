<html xmlns="http://www.w3.org/1999/xhtml"
      xmlns:i18n="http://xml.zope.org/namespaces/i18n"
      xmlns:metal="http://xml.zope.org/namespaces/metal"
      xmlns:tal="http://xml.zope.org/namespaces/tal"
      lang="en"
      metal:use-macro="context/main_template/macros/master"
      xml:lang="en"
      i18n:domain="docpool.elan"
>
  <body>
    <metal:content-core fill-slot="content-core">
      <metal:content-core define-macro="content-core"
                          tal:define="
                            auth_token context/@@authenticator/token;
                          "
      >
        <table class="table table-striped table-responsive table-bordered"
               tal:define="
                 toLocalizedTime nocall: context/@@plone/toLocalizedTime;
               "
        >
          <thead>
            <tr>
              <th i18n:translate="">Created</th>
              <th i18n:translate="">Title/Description</th>
              <th i18n:translate="">Status</th>
              <th i18n:translate="">Docpools</th>
              <th tal:condition="python:view.document_pool"
                  i18n:translate=""
              >Entries</th>
            </tr>
          </thead>
          <tbody>
            <tr tal:repeat="scenario python:context.getDPEvents()">
              <td>
                <span tal:define="
                        modinfo python:scenario.modInfo(show_created=True);
                        date python:modinfo[0];
                        uinfo python:modinfo[1];
                      ">
                  <tal:var replace="uinfo" />
                  <br />
                  <em><tal:var replace="python:toLocalizedTime(date, long_format=1)" />
                    (<tal:var i18n:translate="">LT</tal:var>)</em>
                </span>
              </td>
              <td tal:define="
                    event_type python:scenario.EventType or '';
                  ">
                <a href=""
                   tal:attributes="
                     href python: scenario.absolute_url();
                   "
                >
                  <tal:if condition="python: event_type == 'Exercise'">
                    <em i18n:translate="">++++ Exercise ++++</em>
                    <br />
                  </tal:if>
                  <tal:if condition="python: event_type == 'Test'">
                    <em i18n:translate="">++++ Test ++++</em>
                    <br />
                  </tal:if>

                  <b tal:content="python: scenario.title">
                                Title
                  </b>
                </a>
                <br />
                <span tal:content="python:scenario.description"></span>
              </td>
              <td tal:content="scenario/Status"
                  i18n:translate=""
              ></td>
              <td tal:define="
                    docpools python: scenario.subscribed_docpools();
                  ">
                <tal:if condition="docpools">
                  ${python:', '.join(sorted(dp.Title() for dp in docpools))}
                </tal:if>
                <tal:if condition="not: docpools">
                  <a href="${python:scenario.absolute_url()}/@@delete_confirmation?authenticator=${auth_token}"
                     i18n:domain="plone"
                     i18n:translate=""
                  >
                    Delete
                  </a>
                </tal:if>
              </td>
              <td tal:condition="python:view.document_pool"
                  tal:content="python: view.number_of_entries(scenario)"
              ></td>
            </tr>
          </tbody>
        </table>
        <p tal:condition="python: view.show_edit_link">
          <a href="${python:context.absolute_url()}/@@edit-subscribed-events"
             i18n:translate=""
          >Edit event subscriptions</a>
        </p>
        <p tal:define="
             global_events_link python: view.global_events_link;
           "
           tal:condition="global_events_link"
        >
          <a href="${global_events_link}"
             i18n:translate=""
          >Edit global events</a>
        </p>
      </metal:content-core>
    </metal:content-core>
  </body>
</html>
